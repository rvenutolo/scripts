#!/usr/bin/env bash

# @description Git pre-push hook. Runs run-all-checks inside the flake devShell — the full local
#              gate: check-scripts (shellcheck + shdoc audit), `nix flake check` (formatting), the
#              governance suite, the lint suite, and the BATS suite — aborting the push if it
#              fails. One runner rather than a hand-maintained step list, so the hook, the docs,
#              and the justfile cannot drift apart. Bypass with `git push --no-verify`.
# @arg $@ args git passes ref/sha pairs that this hook does not use
# @exitcode 0 run-all-checks passed
# @exitcode 1 run-all-checks failed; push aborted

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
# A push from a linked worktree exports an absolute GIT_DIR into this hook; the gate below
# runs the BATS suite, whose fixture git commands would all be retargeted at this repo by
# that inherited context. Strip it before resolving paths or running any tooling.
git::clear_local_env
# check-scripts and .ci/ live at the repo root, not under SCRIPTS_DIR (= repo-root/scripts).
REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
# Test seam for the gate invocation below. Production leaves it unset; test/ci/pre-push.bats
# points it at a fixture repo holding stub .ci/in-devshell and run-all-checks, so the tests
# exercise this hook without running the real gate — which takes minutes and would recurse
# into the very BATS suite running them. Deliberately a derived path rather than an override
# of REPO_DIR itself: that keeps `git rev-parse` unconditional, so its failure still reaches
# the ERR trap instead of being masked inside a ${VAR:-$(...)} default. Mirrors
# GOVERNANCE_CI_DIR_OVERRIDE.
readonly GATE_DIR="${PRE_PUSH_GATE_DIR_OVERRIDE:-${REPO_DIR}}"
log::enable_err_trap
# pass-through: git passes ref/sha pairs on stdin we ignore

log::log 'pre-push: running the full local gate'
if ! "${GATE_DIR}/.ci/in-devshell" "${GATE_DIR}/run-all-checks"; then
  log::die 'run-all-checks failed — push aborted. Fix issues or rerun with --no-verify to bypass.'
fi
log::log 'pre-push: gate passed'
