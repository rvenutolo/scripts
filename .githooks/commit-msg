#!/usr/bin/env bash

# @description Git commit-msg hook. Validates the prospective commit message via commitlint. Bypass with `git commit --no-verify`.
# @arg $1 commit_msg_file path to the file containing the prospective commit message (passed by git)
# @exitcode 0 commit message passes commitlint
# @exitcode 1 commitlint not installed or message failed validation

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0 (#290).
shopt -s inherit_errexit
IFS=$'\n\t'

#shellcheck disable=SC1091
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_exactly_1_arg "$@"

readonly COMMIT_MSG_FILE="$1"

# Deliberately outside the hermetic .ci/in-devshell boundary that every other gate
# goes through: this hook shells out to exactly one tool, and paying a nix evaluation
# on every single commit to hermetically resolve one binary is not worth it. commitlint
# comes from the ambient (direnv) PATH. Do not "fix" this — see CLAUDE.md, "Gates run
# inside the hermetic devShell".
if ! commands::executable_exists 'commitlint'; then
  log::die 'commit-msg: commitlint not found on PATH — install it or bypass with --no-verify'
fi

log::log 'commit-msg: running commitlint'
commitlint --edit "${COMMIT_MSG_FILE}"
