# MkDocs build output
site/

# Generated docs (regenerated by main/build-docs in CI)
.docs/functions/
.docs/scripts/
.docs/index.md

# Nix / direnv
.direnv/
result

# Vendored source patches applied by flake.nix. These are source, not stray
# diffs, and a *.patch rule in a global ignore file would otherwise hide them.
!.nix/*.patch
