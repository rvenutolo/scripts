bats_require_minimum_version 1.5.0

setup() {
  load '../test_helper/common'
  # shellcheck disable=SC1091
  source "${SCRIPTS_DIR}/functions/args.bash"
  # shellcheck disable=SC1091
  source "${SCRIPTS_DIR}/functions/log.bash"
  # shellcheck disable=SC1091
  source "${SCRIPTS_DIR}/functions/namerefs.bash"
  # shellcheck disable=SC1091
  source "${SCRIPTS_DIR}/functions/git.bash"
  load '../test_helper/git_fixture'

  REPO="${BATS_TEST_TMPDIR}/repo"
  git_fixture::init "${REPO}"
  HOOKS="${REPO}/.git/hooks"
  mkdir --parents -- "${HOOKS}"
}

# Hooks are fixture text only: no test executes a hook, so the exec lines never run.

# @description Print a hook as a nix-packaged pre-commit generates it.
# @arg $1 hook_type the --hook-type value
# @arg $2 shell basename of the shebang interpreter (bash or sh)
function _nix_hook() {
  local -r hook_type="$1"
  local -r shell="$2"
  # shellcheck disable=SC2016 # literal hook text: the $ expressions belong to the generated hook, not this shell
  printf '%s\n' \
    "#!/nix/store/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-bash-5.3p20/bin/${shell}" \
    '# File generated by pre-commit: https://pre-commit.com' \
    '# ID: 138fd403232d2ddd5efb44317e38bf03' \
    '' \
    '# start templated' \
    'INSTALL_PYTHON=/nix/store/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb-python3-3.14.8/bin/python3.14' \
    "ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=${hook_type})" \
    '# end templated' \
    '' \
    'HERE="$(cd "$(dirname "$0")" && pwd)"' \
    'ARGS+=(--hook-dir "$HERE" -- "$@")' \
    '' \
    'exec /nix/store/cccccccccccccccccccccccccccccccc-pre-commit-4.7.0/bin/pre-commit "${ARGS[@]}"'
}

# @description Print the PATH-resolving form of _nix_hook.
# @arg $1 hook_type the --hook-type value
# @arg $2 shell basename of the shebang interpreter (bash or sh)
function _path_hook() {
  local -r hook_type="$1"
  local -r shell="$2"
  _nix_hook "${hook_type}" "${shell}" \
    | sed --expression="1s|.*|#!/usr/bin/env ${shell}|" \
      --expression='s|^exec /nix/store/[^/]*/bin/pre-commit |exec pre-commit |'
}

# @description Write content to a hook file with mode 0755.
# @arg $1 name hook file name under HOOKS
# @arg $2 content file content
function _write_hook() {
  local -r name="$1"
  local -r content="$2"
  printf '%s\n' "${content}" > "${HOOKS}/${name}"
  chmod 0755 "${HOOKS}/${name}"
}

# ---------- git::repair_pre_commit_hooks ----------

@test "repair_pre_commit_hooks: rewrites the bash shebang and exec line of a generated hook" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(< "${HOOKS}/pre-commit")" "$(_path_hook 'pre-commit' 'bash')"
  assert_equal "${#unrepaired[@]}" 0
}

@test "repair_pre_commit_hooks: rewrites an sh shebang to env sh" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'sh')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(head --lines=1 "${HOOKS}/pre-commit")" '#!/usr/bin/env sh'
}

@test "repair_pre_commit_hooks: keeps the inert INSTALL_PYTHON store path" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  run grep --count '^INSTALL_PYTHON=/nix/store/' "${HOOKS}/pre-commit"
  assert_output '1'
}

@test "repair_pre_commit_hooks: keeps the executable mode" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  run stat --format='%a' "${HOOKS}/pre-commit"
  assert_output '755'
}

@test "repair_pre_commit_hooks: repairs every generated hook type" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  _write_hook 'commit-msg' "$(_nix_hook 'commit-msg' 'bash')"
  _write_hook 'pre-push' "$(_nix_hook 'pre-push' 'bash')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(< "${HOOKS}/pre-commit")" "$(_path_hook 'pre-commit' 'bash')"
  assert_equal "$(< "${HOOKS}/commit-msg")" "$(_path_hook 'commit-msg' 'bash')"
  assert_equal "$(< "${HOOKS}/pre-push")" "$(_path_hook 'pre-push' 'bash')"
}

@test "repair_pre_commit_hooks: logs each rewritten hook to stderr" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  run --separate-stderr git::repair_pre_commit_hooks "${REPO}" unrepaired
  assert_success
  assert_output ''
  assert_stderr --partial "Rewrote ${HOOKS}/pre-commit"
}

@test "repair_pre_commit_hooks: leaves an already PATH-resolving hook byte-identical and silent" {
  _write_hook 'pre-commit' "$(_path_hook 'pre-commit' 'bash')"
  cp --preserve=all -- "${HOOKS}/pre-commit" "${BATS_TEST_TMPDIR}/before"
  run --separate-stderr git::repair_pre_commit_hooks "${REPO}" unrepaired
  assert_success
  assert_stderr ''
  run cmp -- "${BATS_TEST_TMPDIR}/before" "${HOOKS}/pre-commit"
  assert_success
}

@test "repair_pre_commit_hooks: is idempotent" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(< "${HOOKS}/pre-commit")" "$(_path_hook 'pre-commit' 'bash')"
}

@test "repair_pre_commit_hooks: leaves a hook pre-commit did not generate untouched, even with store paths" {
  _write_hook 'pre-push' $'#!/nix/store/dddddddddddddddddddddddddddddddd-bash/bin/bash\necho PAYLOAD_RAN'
  cp -- "${HOOKS}/pre-push" "${BATS_TEST_TMPDIR}/before"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  run cmp -- "${BATS_TEST_TMPDIR}/before" "${HOOKS}/pre-push"
  assert_success
  assert_equal "${#unrepaired[@]}" 0
}

@test "repair_pre_commit_hooks: requires the generated marker on the second line" {
  # The marker anywhere but line 2 is not how pre-commit writes its hooks.
  _write_hook 'pre-commit' \
    $'#!/nix/store/dddddddddddddddddddddddddddddddd-bash/bin/bash\n\n# File generated by pre-commit: https://pre-commit.com'
  cp -- "${HOOKS}/pre-commit" "${BATS_TEST_TMPDIR}/before"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  run cmp -- "${BATS_TEST_TMPDIR}/before" "${HOOKS}/pre-commit"
  assert_success
}

@test "repair_pre_commit_hooks: leaves .sample files untouched" {
  _write_hook 'pre-commit.sample' "$(_nix_hook 'pre-commit' 'bash')"
  cp -- "${HOOKS}/pre-commit.sample" "${BATS_TEST_TMPDIR}/before"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  run cmp -- "${BATS_TEST_TMPDIR}/before" "${HOOKS}/pre-commit.sample"
  assert_success
}

@test "repair_pre_commit_hooks: tolerates empty and one-line hook files" {
  : > "${HOOKS}/empty"
  _write_hook 'one-line' '#!/nix/store/dddddddddddddddddddddddddddddddd-bash/bin/bash'
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(< "${HOOKS}/one-line")" '#!/nix/store/dddddddddddddddddddddddddddddddd-bash/bin/bash'
  assert_equal "${#unrepaired[@]}" 0
}

@test "repair_pre_commit_hooks: an empty hooks dir yields an empty result" {
  mkdir --parents -- "${REPO}/empty-hooks"
  git_fixture::run "${REPO}" config core.hooksPath "${REPO}/empty-hooks"
  local unrepaired=('stale')
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "${#unrepaired[@]}" 0
}

@test "repair_pre_commit_hooks: a missing hooks dir yields an empty result" {
  git_fixture::run "${REPO}" config core.hooksPath "${REPO}/no-such-dir"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "${#unrepaired[@]}" 0
}

@test "repair_pre_commit_hooks: reports and leaves unmodified a generated hook with an unknown store reference" {
  local content
  content="$(_nix_hook 'pre-commit' 'bash')"$'\n''echo /nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-unknown'
  _write_hook 'pre-commit' "${content}"
  cp -- "${HOOKS}/pre-commit" "${BATS_TEST_TMPDIR}/before"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  run cmp -- "${BATS_TEST_TMPDIR}/before" "${HOOKS}/pre-commit"
  assert_success
  assert_equal "${#unrepaired[@]}" 1
  assert_equal "${unrepaired[0]}" "${HOOKS}/pre-commit"
}

@test "repair_pre_commit_hooks: warns on stderr naming the line it cannot rewrite" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"$'\n''echo /nix/store/eeee-unknown'
  run --separate-stderr git::repair_pre_commit_hooks "${REPO}" unrepaired
  assert_success
  assert_stderr --partial 'echo /nix/store/eeee-unknown'
}

@test "repair_pre_commit_hooks: an unrepairable hook does not stop the others being repaired" {
  # commit-msg sorts before pre-commit, so the bad hook is reached first.
  _write_hook 'commit-msg' "$(_nix_hook 'commit-msg' 'bash')"$'\n''echo /nix/store/eeee-unknown'
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(< "${HOOKS}/pre-commit")" "$(_path_hook 'pre-commit' 'bash')"
  assert_equal "${#unrepaired[@]}" 1
  assert_equal "${unrepaired[0]}" "${HOOKS}/commit-msg"
}

@test "repair_pre_commit_hooks: reports every unrepairable hook" {
  _write_hook 'commit-msg' "$(_nix_hook 'commit-msg' 'bash')"$'\n''echo /nix/store/eeee-unknown'
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"$'\n''echo /nix/store/ffff-unknown'
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "${#unrepaired[@]}" 2
}

@test "repair_pre_commit_hooks: resets the out array before filling it" {
  local unrepaired=('stale-1' 'stale-2')
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "${#unrepaired[@]}" 0
}

@test "repair_pre_commit_hooks: honors core.hooksPath" {
  local -r custom="${REPO}/custom-hooks"
  mkdir --parents -- "${custom}"
  git_fixture::run "${REPO}" config core.hooksPath "${custom}"
  _nix_hook 'pre-commit' 'bash' > "${custom}/pre-commit"
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(< "${custom}/pre-commit")" "$(_path_hook 'pre-commit' 'bash')"
  assert_equal "$(< "${HOOKS}/pre-commit")" "$(_nix_hook 'pre-commit' 'bash')"
}

@test "repair_pre_commit_hooks: works on a repo path given from another working directory" {
  _write_hook 'pre-commit' "$(_nix_hook 'pre-commit' 'bash')"
  cd "${BATS_TEST_TMPDIR}"
  local unrepaired=()
  git::repair_pre_commit_hooks "${REPO}" unrepaired 2> /dev/null
  assert_equal "$(< "${HOOKS}/pre-commit")" "$(_path_hook 'pre-commit' 'bash')"
}

@test "repair_pre_commit_hooks: dies when the path is not a git repo" {
  mkdir --parents -- "${BATS_TEST_TMPDIR}/plain"
  run --separate-stderr git::repair_pre_commit_hooks "${BATS_TEST_TMPDIR}/plain" unrepaired
  assert_failure 1
  assert_stderr --partial 'is not a git repo'
}

@test "repair_pre_commit_hooks: the reserved out-variable nameref name is refused" {
  run --separate-stderr git::repair_pre_commit_hooks "${REPO}" '__git_repair_pre_commit_hooks_ref'
  assert_failure 1
  assert_stderr --partial "out-parameter may not be named '__git_repair_pre_commit_hooks_ref'"
}

@test "repair_pre_commit_hooks: dies with 0 args" {
  run --separate-stderr git::repair_pre_commit_hooks
  assert_failure 1
  assert_stderr --partial 'Expected exactly 2 arguments'
}

@test "repair_pre_commit_hooks: dies with 1 arg" {
  run --separate-stderr git::repair_pre_commit_hooks "${REPO}"
  assert_failure 1
  assert_stderr --partial 'Expected exactly 2 arguments'
}

@test "repair_pre_commit_hooks: dies with 3 args" {
  run --separate-stderr git::repair_pre_commit_hooks "${REPO}" unrepaired extra
  assert_failure 1
  assert_stderr --partial 'Expected exactly 2 arguments'
}
