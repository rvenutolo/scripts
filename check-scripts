#!/usr/bin/env bash

# @description Run the combined shellcheck, check-shdoc-headers, and check-executable-bit gate over shell scripts in the repo. When invoked with no paths, checks every in-scope script. The shdoc-header audit and the executable-bit audit always run over the full in-scope set regardless of per-file args, since header presence and file modes are whole-repo properties. Aggregates exit codes so a failure in any tool fails the whole run.
# @arg $@ paths Optional file or directory paths to check; omit to check the full in-scope set.
# @exitcode 0 All files pass shellcheck, and the shdoc header and executable-bit audits are clean.
# @exitcode 1 One or more files failed shellcheck, check-shdoc-headers, or check-executable-bit.

set -Eeuo pipefail
IFS=$'\n\t'

#shellcheck disable=SC1091
source "${SCRIPTS_DIR}/.functions.bash"
# .ci/ lives at the repo root, not under SCRIPTS_DIR (= repo-root/scripts).
REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
log::enable_err_trap
args::handle_help_flag "$@"
system::require_bash_version 4 3

shell_scripts::assert_paths_exist "$@"

rc=0
# Always audit the full in-scope set — partial runs would let regressions slip in.
"${REPO_DIR}/.ci/check-shdoc-headers" || rc=1
"${REPO_DIR}/.ci/check-executable-bit" || rc=1

files::create_temp candidates_tmp
# shellcheck disable=SC2154 # candidates_tmp set via nameref inside files::create_temp
shell_scripts::find "$@" > "${candidates_tmp}"
mapfile -t candidates < "${candidates_tmp}"
if [[ "${#candidates[@]}" -eq 0 ]]; then
  exit "${rc}"
fi

files=()
shell_scripts::filter files "${candidates[@]}"
if [[ "${#files[@]}" -eq 0 ]]; then
  exit "${rc}"
fi

shellcheck "${files[@]}" || rc=1
exit "${rc}"
