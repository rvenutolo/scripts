#!/usr/bin/env bash

# @description Run the combined shfmt, shellcheck, check-shdoc-headers, and check-executable-bit gate over shell scripts in the repo. When invoked with no paths, checks every in-scope script. The shdoc-header audit and the executable-bit audit always run over the full in-scope set regardless of per-file args, since header presence and file modes are whole-repo properties. The shfmt step verifies formatting without rewriting anything; it covers the extensionless top-level executables and *.bats files that `nix fmt` cannot see, because treefmt matches formatters by file extension. Explicitly-passed non-shell files are skipped by that step rather than parsed as shell. Aggregates exit codes so a failure in any tool fails the whole run.
# @arg $@ paths Optional file or directory paths to check; omit to check the full in-scope set.
# @exitcode 0 All files are correctly formatted and pass shellcheck, and the shdoc header and executable-bit audits are clean.
# @exitcode 1 One or more files are misformatted or failed shellcheck, check-shdoc-headers, or check-executable-bit.

set -Eeuo pipefail
IFS=$'\n\t'

#shellcheck disable=SC1091
source "${SCRIPTS_DIR}/.functions.bash"
# .ci/ lives at the repo root, not under SCRIPTS_DIR (= repo-root/scripts).
REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
log::enable_err_trap
args::handle_help_flag "$@"
system::require_bash_version 4 3

shell_scripts::assert_paths_exist "$@"

rc=0
# Always audit the full in-scope set — partial runs would let regressions slip in.
"${REPO_DIR}/.ci/check-shdoc-headers" || rc=1
"${REPO_DIR}/.ci/check-executable-bit" || rc=1

files::create_temp candidates_tmp
# shellcheck disable=SC2154 # candidates_tmp set via nameref inside files::create_temp
shell_scripts::find "$@" > "${candidates_tmp}"
mapfile -t candidates < "${candidates_tmp}"
if [[ "${#candidates[@]}" -eq 0 ]]; then
  exit "${rc}"
fi

# shfmt formatting gate. Deliberately runs over `candidates` rather than the
# post-filter `files` list used for shellcheck, so *.bats files are covered too: they
# begin with `@test` rather than a shebang, so shell_scripts::filter drops them, but
# shfmt detects the bats dialect from the extension and formats them like any other
# script.
#
# This gate exists because `nix fmt` cannot replace it. treefmt matches formatters to
# files by EXTENSION, and this repo's top-level executables have none by convention, so
# treefmt's shfmt only ever sees *.sh/*.bash — leaving the ~306 extensionless
# executables and ~68 .bats files with no formatting gate at all.
#
# No style flags are passed on purpose. shfmt reads .editorconfig for style, but ONLY
# when it is given no parser or printer flag — adding -i/-ci/-bn/-sr here would
# silently disable that and fork the style definition between this gate and
# .treefmt.nix. --list and --diff are top-level flags and do not disable it. The single
# source of truth for shell style is .editorconfig.
shfmt_targets=()
for candidate in "${candidates[@]}"; do
  # shell_scripts::find echoes an explicitly-passed file verbatim, so a non-shell
  # path (a .md, say) reaches here and shfmt parses it as shell and fails. The
  # no-arg path never hits this: `shfmt --find` only ever emits shell files. The
  # skip is silent because the shellcheck step below reports it. See issue #206.
  if ! shell_scripts::is_shell_file "${candidate}"; then
    continue
  fi
  # Never format-check third-party scripts. shell_scripts::find already excludes
  # other/ on its no-arg scan; this also covers an explicitly passed path under it.
  if [[ "${candidate}" == */other/* ]]; then
    continue
  fi
  shfmt_targets+=("${candidate}")
done
if [[ "${#shfmt_targets[@]}" -gt 0 ]]; then
  shfmt --list --diff -- "${shfmt_targets[@]}" || rc=1
fi

files=()
shell_scripts::filter files "${candidates[@]}"
if [[ "${#files[@]}" -eq 0 ]]; then
  exit "${rc}"
fi

shellcheck "${files[@]}" || rc=1
exit "${rc}"
