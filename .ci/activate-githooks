#!/usr/bin/env bash

# @description Point this clone's core.hooksPath at the tracked .githooks
#              directory so the repo's commit-msg and pre-push hooks actually
#              fire. Activation is otherwise a manual, per-clone `git config`
#              step, and repo-local config cannot be committed — so it silently
#              never happens and both tracked hooks sit inert.
#              This script exists so the flake devShell can do it instead:
#              `direnv allow` / `nix develop` is the one onboarding step a
#              contributor cannot skip. Idempotent and completely silent once
#              the value is already correct, because it runs on every direnv
#              reload and every `nix develop --command` in CI. A foreign
#              core.hooksPath is overwritten and logged — leaving it in place
#              would mean silently inert hooks, which is the bug being fixed.
#
#              Standalone on purpose, unlike every other script under .ci/: it
#              runs from the devShell shellHook, including under
#              `nix develop --ignore-environment`, where SCRIPTS_DIR does not
#              exist and sourcing the function library would kill it under
#              set -u. Bootstrapping a clone cannot depend on the environment
#              that clone has not set up yet, so this inlines the ERR trap and
#              its handful of helpers the way scripts/misc/ standalone scripts
#              do — and omits args::handle_help_flag along with them, since a
#              shellHook never passes --help.
# @noargs
# @stderr One line naming the change, on the runs that change something.
# @exitcode 0 the tracked hooks are active, already or as of this run.
# @exitcode 1 the working directory is not inside a git repo, or an argument was given.

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "\033[0;31m[%s %s] ERROR: line %s (exit %s): %s\033[0m\n" "$(date +%T)" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# Repo-root-relative on purpose: git resolves core.hooksPath against the work
# tree root, so one value is correct for every clone and every machine.
readonly HOOKS_PATH='.githooks'

function main() {
  if (($# > 0)); then
    printf '%s: expected no arguments, got %s\n' "${0##*/}" "$#" >&2
    exit 1
  fi
  local repo_root
  if ! repo_root="$(git rev-parse --show-toplevel 2> '/dev/null')"; then
    printf '%s: not a git repo: %s\n' "${0##*/}" "$(pwd)" >&2
    exit 1
  fi
  local current
  # `--get` exits 1 when the key is unset, which is the ordinary first-run case.
  current="$(git -C "${repo_root}" config --local --get core.hooksPath || true)"
  if [[ "${current}" == "${HOOKS_PATH}" ]]; then
    return 0
  fi
  git -C "${repo_root}" config --local core.hooksPath "${HOOKS_PATH}"
  if [[ -z "${current}" ]]; then
    printf '%s: activated the tracked git hooks: core.hooksPath set to %s\n' \
      "${0##*/}" "${HOOKS_PATH}" >&2
  else
    printf '%s: repointed core.hooksPath from %s to %s\n' \
      "${0##*/}" "${current}" "${HOOKS_PATH}" >&2
  fi
}

main "$@"
