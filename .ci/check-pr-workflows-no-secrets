#!/usr/bin/env bash

# @description Assert that no GitHub Actions workflow triggered by
#              `pull_request` or `pull_request_target` references any secret
#              other than GITHUB_TOKEN, in any form .ci/secret-refs.awk reads:
#              `secrets.NAME`, `secrets['NAME']`, the whole context
#              (`toJSON(secrets)`, a computed index), or `secrets: inherit`.
#              PR-triggered workflows can run from forks, so exposing custom
#              secrets to them is a credential-exfiltration risk.
# @noargs
# @stderr One line per violation, plus a final count.
# @exitcode 0 no PR-triggered workflow references a disallowed secret.
# @exitcode 1 one or more disallowed secret references found.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"
commands::assert_executable_exists 'yq'
commands::assert_executable_exists 'gawk'

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly WORKFLOWS_DIR="${WORKFLOWS_DIR_OVERRIDE:-${REPO_DIR}/.github/workflows}"
readonly SECRET_REFS_AWK="${REPO_DIR}/.ci/secret-refs.awk"

# @description Print every trigger name a workflow declares, one per line.
#              Handles all three shapes of `.on`: scalar (`on: pull_request`),
#              sequence (`on: [push, pull_request]`), and map
#              (`on:\n  pull_request:`).
#
#              Deliberately a producer rather than a predicate. As a predicate it
#              would be called from an `if`, which disables errexit for its whole
#              call tree — so a `yq` failure on an unparsable workflow would read
#              as "not triggered", the file would go unscanned, and the lint
#              would still exit 0. Called as a plain command, a `yq` failure
#              aborts the lint.
# @arg $1 file path to a workflow YAML
# @stdout One trigger name per line.
function workflow_triggers() {
  args::check_exactly_1_arg "$@"
  local -r file="$1"
  # Emit every trigger name regardless of `.on` shape: map keys, sequence
  # members, and a bare scalar. Each branch is guarded by select(type) so the
  # other two shapes contribute nothing instead of erroring.
  yq eval '
    (.on | select(type == "!!map") | keys | .[]),
    (.on | select(type == "!!seq") | .[]),
    (.on | select(type == "!!str"))
  ' "${file}"
}

# @description Scan a PR-triggered workflow for disallowed secret
#              references. Prints violations to stderr; echoes the violation
#              count to stdout.
# @arg $1 file path to a workflow YAML
# @stdout integer violation count
function scan_secrets() {
  args::check_exactly_1_arg "$@"
  local -r file="$1"
  local matches_tmp
  files::create_temp matches_tmp
  # shellcheck disable=SC2154 # matches_tmp assigned by files::create_temp via nameref
  gawk --file="${SECRET_REFS_AWK}" "${file}" > "${matches_tmp}"
  local count=0
  local path lineno kind value reference
  while IFS=$'\t' read -r path lineno kind value; do
    if [[ "${kind}" == 'name' ]]; then
      # GITHUB_TOKEN is the one auto-provisioned, fork-safe token; every other
      # reference is flagged.
      if [[ "${value}" == 'GITHUB_TOKEN' ]]; then
        continue
      fi
      reference="secrets.${value}"
    else
      reference="${value}"
    fi
    printf '%s:%s: %s not allowed in PR-triggered workflow\n' "${path}" "${lineno}" "${reference}" >&2
    count=$((count + 1))
  done < "${matches_tmp}"
  printf '%s\n' "${count}"
}

function main() {
  args::check_no_args "$@"
  # Not `if ! dirs::exists ...; then exit 0; fi`: an absent scan target is a
  # misdirected scan, and reporting it as a clean pass is indistinguishable from
  # having checked every workflow and found them all fine.
  dirs::assert_exists "${WORKFLOWS_DIR}"
  local files_tmp triggers_tmp
  files::create_temp files_tmp
  files::create_temp triggers_tmp
  find "${WORKFLOWS_DIR}" -type f \( -name '*.yml' -o -name '*.yaml' \) > "${files_tmp}"
  local total=0
  local file n
  while IFS= read -r file; do
    workflow_triggers "${file}" > "${triggers_tmp}"
    if grep --line-regexp --quiet --extended-regexp 'pull_request|pull_request_target' "${triggers_tmp}"; then
      n="$(scan_secrets "${file}")"
      total=$((total + n))
    fi
  done < "${files_tmp}"
  if ((total > 0)); then
    printf '%d disallowed secret reference(s) in PR-triggered workflow(s)\n' "${total}" >&2
    exit 1
  fi
  exit 0
}

main "$@"
