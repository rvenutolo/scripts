#!/usr/bin/env bash

# @description Assert no workflow declares `paths:` or `paths-ignore:` under
#              `on.pull_request:`. Path filters on PR triggers create the
#              auto-merge trap where required checks are skipped (and count as
#              passed) on path-narrow PRs.
# @noargs
# @stderr One line per offending workflow.
# @exitcode 0 no PR-trigger path filters found.
# @exitcode 1 one or more workflows declare path filters under pull_request.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"
commands::assert_executable_exists 'yq'

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly WORKFLOWS_DIR="${WORKFLOWS_DIR_OVERRIDE:-${REPO_DIR}/.github/workflows}"

function main() {
  args::check_no_args "$@"
  # Not `if ! dirs::exists ...; then exit 0; fi`: an absent scan target is a
  # misdirected scan, and reporting it as a clean pass is indistinguishable from
  # having checked every workflow and found them all fine (#250, #290, #307, #323).
  dirs::assert_exists "${WORKFLOWS_DIR}"
  local files_tmp
  files::create_temp files_tmp
  find "${WORKFLOWS_DIR}" -type f \( -name '*.yml' -o -name '*.yaml' \) > "${files_tmp}"
  local failed=0
  local file has_filter
  while IFS= read -r file; do
    strings::is_empty "${file}" && continue
    # Both select(type == "!!map") guards are load bearing, and the outer one
    # is the reason this no longer swallows errors. `.on.pull_request` on a
    # flow-list trigger (`on: [pull_request]`) errors while indexing, BEFORE any
    # select on the result can filter it — so guarding only the inner value left
    # a `yq` failure on a legitimate workflow, which the old
    # `2> /dev/null || printf 'false'` fallback then hid. That fallback also hid
    # a genuinely unreadable document, reporting it as "declares no path filter"
    # and exiting 0 (#294). Guarding `.on` itself handles every legal shape
    # without erroring, so the fallback is gone and a real parse failure now
    # aborts the lint.
    has_filter="$(yq eval '
      (.on
        | select(type == "!!map")
        | .pull_request
        | select(type == "!!map")
        | (has("paths") or has("paths-ignore"))) // false
    ' "${file}")"
    if [[ "${has_filter}" == 'true' ]]; then
      printf '%s: declares paths/paths-ignore under on.pull_request\n' "${file}" >&2
      failed=1
    fi
  done < "${files_tmp}"
  exit "${failed}"
}

main "$@"
