#!/usr/bin/env bash

# @description Assert the repo has exactly one justfile, that it is the hidden
#              .justfile, that its recipe set and README's command table agree
#              bidirectionally, and that the full-gate entry points still name
#              ./run-all-checks. Two tracked justfiles made `just` refuse to run
#              at all, taking out every documented invocation (#218); README's
#              table had meanwhile drifted into a union matching neither file.
#              The gate assertions cover the machine-readable copies of the gate
#              description (#222) — CLAUDE.md's prose list is deliberately out of
#              scope, since string-matching prose fails on rewording.
#              Recipe parsing is delegated to `just --dump`, so the repo does not
#              re-encode just's grammar (#229); README scanning is scoped to the
#              `## Common commands` section (#230).
#              Every public recipe must also carry a doc comment.
# @noargs
# @stderr One line per violation.
# @exitcode 0 the justfile is unique, canonical, and agrees with the docs.
# @exitcode 1 a duplicate or missing justfile, an unparseable justfile, a missing README command table, a recipe/README mismatch, gate-name drift, or an undocumented public recipe.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0 (#290).
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"
# gawk still scans README's markdown; just + jq parse the justfile itself.
commands::assert_executable_exists 'gawk'
commands::assert_executable_exists 'just'
commands::assert_executable_exists 'jq'

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly ROOT_DIR="${ROOT_DIR_OVERRIDE:-${REPO_DIR}}"
readonly JUSTFILE="${JUSTFILE_OVERRIDE:-${ROOT_DIR}/.justfile}"
readonly README_MD="${README_OVERRIDE:-${ROOT_DIR}/README.md}"
readonly PR_TEMPLATE="${PR_TEMPLATE_OVERRIDE:-${ROOT_DIR}/.github/PULL_REQUEST_TEMPLATE.md}"

# The canonical basename. Hidden, matching the repo's other hidden root config
# (.mkdocs.yml, .treefmt.nix); 7691c69 renamed it deliberately, and 517b0c6
# re-created an unhidden copy by accident.
readonly CANONICAL_JUSTFILE='.justfile'

# Every basename `just` treats as a candidate. More than one at the repo root
# makes `just` refuse to run rather than pick one.
readonly CANDIDATES=(justfile Justfile JUSTFILE .justfile .JUSTFILE)

# The recipe that must invoke the full local gate, and the command it must run.
readonly GATE_RECIPE='all'
readonly GATE_COMMAND='./run-all-checks'

# `default` aliases another recipe rather than naming a distinct command, and
# README documents it as an annotation on the aliased row ("`just check`
# (default)"). Requiring a `just default` row would be wrong.
readonly PARITY_EXEMPT_RECIPES=(default)

# @description Print the basenames of justfile candidates present in a directory.
# @arg $1 root_dir directory to scan
# @stdout One candidate basename per line; nothing when none are present.
function justfile_candidates() {
  args::check_exactly_1_arg "$@"
  local -r root_dir="$1"
  local candidate
  for candidate in "${CANDIDATES[@]}"; do
    if files::exists "${root_dir}/${candidate}"; then
      printf '%s\n' "${candidate}"
    fi
  done
}

# @description Write `just`'s JSON dump of a justfile to a destination file.
#              Parsing is delegated to `just` itself rather than re-encoded here:
#              this lint used to carry the recipe-name pattern twice, and both
#              copies rejected an uppercase-initial name, so such a recipe was
#              invisible to the justfile parser and the README parser at once and
#              the parity check passed on exactly the case it exists to flag
#              (#229). A justfile `just` cannot parse now fails the lint with
#              just's own file/line/column diagnostic on stderr, which is the
#              fail-closed behavior that issue asked for.
# @arg $1 justfile_path path to the justfile
# @arg $2 dest_path file to write the JSON dump to
# @stderr just's parse diagnostic, when it cannot parse the justfile.
# @exitcode 0 the justfile parsed and the dump was written.
# @exitcode 1 just could not parse the justfile.
function justfile_dump() {
  args::check_exactly_2_args "$@"
  local -r justfile_path="$1"
  local -r dest_path="$2"
  # --working-directory is mandatory: without it just resolves relative paths
  # against its own location, which would make fixture runs depend on the live
  # checkout instead of the temp tree the tests build.
  just --justfile "${justfile_path}" \
    --working-directory "$(dirname "${justfile_path}")" \
    --dump --dump-format json > "${dest_path}"
}

# @description Print every recipe in a justfile dump, one per line, as
#              `visibility<TAB>name` where visibility is `private` or `public`.
#              `just` reports private=true for both a `_` name prefix and a
#              `[private]` attribute, which are the two ways it hides a recipe
#              from `just --list`. Note that `just` rejects digit-initial recipe
#              names outright — contrary to #229's claim, verified on just 1.51.0
#              — so no pattern here needs to accommodate them.
# @arg $1 dump_path path to a JSON dump written by justfile_dump
# @stdout One `private<TAB>name` or `public<TAB>name` line per recipe.
function classified_recipes() {
  args::check_exactly_1_arg "$@"
  local -r dump_path="$1"
  jq --raw-output '
    .recipes
    | to_entries[]
    | (if .value.private then "private" else "public" end) + "\t" + .key
  ' "${dump_path}"
}

# @description Print the name of every public recipe in a justfile dump that
#              carries no doc comment, one per line. `just` reports the comment
#              line immediately above a recipe as its `doc` field, and null when
#              there is none. Private recipes are excluded: they are internal
#              helpers `just --list` never shows, matching how the README parity
#              rule already treats them.
# @arg $1 dump_path path to a JSON dump written by justfile_dump
# @stdout One undocumented public recipe name per line.
function undocumented_recipes() {
  args::check_exactly_1_arg "$@"
  local -r dump_path="$1"
  jq --raw-output '
    .recipes
    | to_entries[]
    | select(.value.private | not)
    | select((.value.doc // "") | test("^\\s*$"))
    | .key
  ' "${dump_path}"
}

# @description Print the recipe names README's `## Common commands` section
#              refers to, one per line. Only rows inside that section are
#              scanned. The previous implementation grepped every line in the
#              file beginning with `|`, so any unrelated markdown table that
#              mentioned a recipe in passing would have registered as a
#              documented command and produced a false failure claiming the
#              justfile does not define it (#230).
# @arg $1 readme_path path to README.md
# @stdout One recipe name per line, sorted and deduplicated.
# @exitcode 0 the section was found.
# @exitcode 1 README has no `## Common commands` heading.
function readme_recipe_names() {
  args::check_exactly_1_arg "$@"
  local -r readme_path="$1"
  if ! grep --quiet --line-regexp --fixed-strings '## Common commands' "${readme_path}"; then
    return 1
  fi
  local rows_tmp
  files::create_temp rows_tmp
  gawk '
    /^## / { inside = ($0 == "## Common commands"); next }
    inside && /^\|/ { print }
  ' "${readme_path}" > "${rows_tmp}"
  # The name pattern matches what just accepts, so an uppercase or underscore
  # recipe documented in README is seen by the README-to-justfile direction.
  grep --only-matching --extended-regexp '`just [A-Za-z_][A-Za-z0-9_-]*' "${rows_tmp}" \
    | cut --delimiter=' ' --fields=2 \
    | sort --unique || true
}

# @description Print the body of one recipe from a justfile dump, with each
#              line's fragments joined. Used to assert the gate recipe still
#              invokes the gate command.
# @arg $1 dump_path path to a JSON dump written by justfile_dump
# @arg $2 recipe recipe name whose body to print
# @stdout The recipe's body, one line per body line; nothing when it has none.
function recipe_body() {
  args::check_exactly_2_args "$@"
  local -r dump_path="$1"
  local -r recipe="$2"
  jq --raw-output --arg want "${recipe}" '
    .recipes[$want].body // [] | .[] | map(tostring) | join("")
  ' "${dump_path}"
}

function main() {
  args::check_no_args "$@"
  local failed=0

  # 1 + 2: exactly one candidate, and it is the canonical hidden name.
  local candidates_tmp
  files::create_temp candidates_tmp
  justfile_candidates "${ROOT_DIR}" > "${candidates_tmp}"
  local -a present=()
  local candidate
  while IFS= read -r candidate; do
    strings::is_empty "${candidate}" && continue
    present+=("${candidate}")
  done < "${candidates_tmp}"

  if ((${#present[@]} == 0)); then
    printf 'no justfile found at %s — expected %s\n' "${ROOT_DIR}" "${CANONICAL_JUSTFILE}" >&2
    exit 1
  fi
  # ${array[*]} joins on IFS's first character, a newline under this script's
  # strict IFS; swap those for spaces so each violation stays on one line.
  local present_list="${present[*]}"
  present_list="${present_list//$'\n'/ }"
  if ((${#present[@]} > 1)); then
    printf 'multiple justfile candidates present (just refuses to run): %s\n' \
      "${present_list}" >&2
    failed=1
  fi
  if ! arrays::contains "${CANONICAL_JUSTFILE}" "${present[@]}"; then
    printf 'the justfile must be named %s, found: %s\n' \
      "${CANONICAL_JUSTFILE}" "${present_list}" >&2
    failed=1
  fi

  files::assert_exists "${JUSTFILE}"
  files::assert_exists "${README_MD}"
  files::assert_exists "${PR_TEMPLATE}"

  # 3: bidirectional recipe/README parity.
  local dump_tmp
  files::create_temp dump_tmp
  if ! justfile_dump "${JUSTFILE}" "${dump_tmp}"; then
    printf '%s: just could not parse this justfile (its diagnostic is above)\n' \
      "${JUSTFILE}" >&2
    exit 1
  fi

  local recipes_tmp readme_tmp
  files::create_temp recipes_tmp
  files::create_temp readme_tmp
  classified_recipes "${dump_tmp}" > "${recipes_tmp}"
  if ! readme_recipe_names "${README_MD}" > "${readme_tmp}"; then
    # shellcheck disable=SC2016 # literal backticks quoting a markdown heading, not command substitution
    printf '%s: no `## Common commands` heading — that section is the documented recipe set\n' \
      "${README_MD}" >&2
    exit 1
  fi

  local -a recipes=() hidden=() documented=()
  local line name
  while IFS= read -r line; do
    strings::is_empty "${line}" && continue
    name="${line#*$'\t'}"
    recipes+=("${name}")
    if [[ "${line%%$'\t'*}" == 'private' ]]; then
      hidden+=("${name}")
    fi
  done < "${recipes_tmp}"
  while IFS= read -r name; do
    strings::is_empty "${name}" && continue
    documented+=("${name}")
  done < "${readme_tmp}"

  for name in ${recipes[@]+"${recipes[@]}"}; do
    arrays::contains "${name}" "${PARITY_EXEMPT_RECIPES[@]}" && continue
    # Hidden recipes are internal helpers, so they are exempt from needing a
    # README row. The other direction stays strict below: documenting one is a
    # real defect, since `just --list` will not show it.
    arrays::contains "${name}" ${hidden[@]+"${hidden[@]}"} && continue
    if ! arrays::contains "${name}" ${documented[@]+"${documented[@]}"}; then
      printf '%s: recipe has no README command-table row\n' "${name}" >&2
      failed=1
    fi
  done
  for name in ${documented[@]+"${documented[@]}"}; do
    if ! arrays::contains "${name}" ${recipes[@]+"${recipes[@]}"}; then
      printf '%s: README names a recipe that %s does not define\n' \
        "${name}" "${CANONICAL_JUSTFILE}" >&2
      failed=1
    elif arrays::contains "${name}" ${hidden[@]+"${hidden[@]}"}; then
      printf '%s: README documents a recipe just hides from --list\n' "${name}" >&2
      failed=1
    fi
  done

  # 4: the gate entry points still name run-all-checks.
  if ! arrays::contains "${GATE_RECIPE}" ${recipes[@]+"${recipes[@]}"}; then
    printf '%s: no such recipe — the full gate must stay reachable as: just %s\n' \
      "${GATE_RECIPE}" "${GATE_RECIPE}" >&2
    failed=1
  else
    local body_tmp
    files::create_temp body_tmp
    recipe_body "${dump_tmp}" "${GATE_RECIPE}" > "${body_tmp}"
    if ! grep --quiet --fixed-strings "${GATE_COMMAND}" "${body_tmp}"; then
      printf 'the %s recipe must invoke %s\n' "${GATE_RECIPE}" "${GATE_COMMAND}" >&2
      failed=1
    fi
  fi
  if ! grep --quiet --fixed-strings "${GATE_COMMAND}" "${PR_TEMPLATE}"; then
    printf 'PULL_REQUEST_TEMPLATE.md must name %s in its test-plan checklist\n' \
      "${GATE_COMMAND}" >&2
    failed=1
  fi

  # 5: every public recipe describes itself. `just --list` renders the doc
  # comment, so an undocumented recipe is invisible to anyone discovering the
  # command set. Private recipes are exempt — --list never shows them.
  local undoc_tmp
  files::create_temp undoc_tmp
  undocumented_recipes "${dump_tmp}" > "${undoc_tmp}"
  local undoc_name
  while IFS= read -r undoc_name; do
    strings::is_empty "${undoc_name}" && continue
    printf '%s: recipe has no doc comment\n' "${undoc_name}" >&2
    failed=1
  done < "${undoc_tmp}"

  exit "${failed}"
}

main "$@"
