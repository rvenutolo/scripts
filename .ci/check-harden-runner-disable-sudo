#!/usr/bin/env bash

# @description Assert every job in every GitHub Actions workflow sets
#              `disable-sudo: true` on its harden-runner step. The input strips
#              the runner user's sudo access, so a compromised step cannot
#              escalate to root and rewrite the runner's own tooling. Jobs that
#              install Nix cannot take it: `DeterminateSystems/nix-installer-action`
#              writes to `/nix` and `/var/lib/determinate` as root and fails with
#              "sudo: a password is required". Those jobs are enumerated in
#              EXEMPT rather than the whole Nix category being skipped, and each
#              EXEMPT entry must name a real job that is genuinely not disabling
#              sudo — a stale entry fails the lint rather than silently
#              disarming it.
# @noargs
# @stderr One line per violation, plus a final count.
# @exitcode 0 every non-exempt job sets disable-sudo: true.
# @exitcode 1 one or more jobs do not, or an EXEMPT entry is stale.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0 (#290).
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"
commands::assert_executable_exists 'yq'

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly WORKFLOWS_DIR="${WORKFLOWS_DIR_OVERRIDE:-${REPO_DIR}/.github/workflows}"

# Jobs exempt from the disable-sudo mandate, as `<workflow-file>:<job-id>`.
# Keyed per job rather than per file so a multi-job workflow cannot be exempted
# wholesale by accident. Every entry below is a job that runs
# `./.github/actions/setup`, which invokes DeterminateSystems/nix-installer-action;
# that action needs root and fails outright under disable-sudo. Verified
# empirically on run 31288422292, where the `governance` job died at
# `/usr/bin/sudo mkdir -p /var/lib/determinate` with "sudo: a password is
# required".
readonly EXEMPT=(
  'ci.yml:check-scripts'                                  # nix-installer-action needs root to write /nix
  'ci.yml:bats'                                           # nix-installer-action needs root to write /nix
  'ci.yml:lint'                                           # nix-installer-action needs root to write /nix
  'ci.yml:governance'                                     # nix-installer-action needs root to write /nix
  'ci.yml:nix-flake-check'                                # nix-installer-action needs root to write /nix
  'ci.yml:coverage'                                       # nix-installer-action needs root to write /nix
  'coverage.yml:coverage'                                 # nix-installer-action needs root to write /nix
  'pages.yml:build'                                       # nix-installer-action needs root to write /nix
  'protect-main-drift-check.yml:protect-main-drift-check' # nix-installer-action needs root to write /nix
  'pr-title-lint.yml:lint-pr-title'                       # nix-installer-action needs root to write /nix
)

# @description Print the harden-runner `with:` value of the given key for one
#              job, or the empty string when the job has no harden-runner step.
# @arg $1 file path to a workflow YAML
# @arg $2 job the job key
# @arg $3 key the `with:` key to read
# @stdout The value, or the empty string.
function harden_runner_with() {
  args::check_exactly_3_args "$@"
  local -r file="$1"
  local -r job_name="$2"
  local -r with_key="$3"
  # The env vars feeding strenv() must not share a name with a readonly local:
  # a command-prefix assignment to a readonly variable aborts the command.
  job="${job_name}" key="${with_key}" yq eval '
    [.jobs[strenv(job)].steps[]
      | select((.uses // "") | test("^step-security/harden-runner@"))]
    | .[0].with[strenv(key)] // ""
  ' "${file}"
}

# @description Print the number of harden-runner steps a job declares.
#              A producer rather than a `has_harden_runner` predicate: a
#              predicate gets called from an `if`, which disables errexit for its
#              whole call tree, so a `yq` failure would yield an empty count and
#              read as "this job has no harden-runner step" — a real finding
#              invented out of a parse error (#294). Called as a command
#              substitution under inherit_errexit, a `yq` failure aborts the lint
#              instead.
# @arg $1 file path to a workflow YAML
# @arg $2 job_name key of the job to inspect
# @stdout The count of harden-runner steps in that job.
function harden_runner_count() {
  args::check_exactly_2_args "$@"
  local -r file="$1"
  local -r job_name="$2"
  # shellcheck disable=SC2016 # yq program literal; strenv is yq syntax, not shell
  job="${job_name}" yq eval '
    [.jobs[strenv(job)].steps[]
      | select((.uses // "") | test("^step-security/harden-runner@"))]
    | length
  ' "${file}"
}

function main() {
  args::check_no_args "$@"
  if ! dirs::exists "${WORKFLOWS_DIR}"; then
    exit 0
  fi

  local -a exempt_entries=()
  arrays::from_env_override exempt_entries EXEMPT_OVERRIDE "${EXEMPT[@]}"

  local files_tmp jobs_tmp seen_tmp
  files::create_temp files_tmp
  files::create_temp seen_tmp
  # -name globs have no long-form equivalent in find.
  find "${WORKFLOWS_DIR}" -type f \( -name '*.yml' -o -name '*.yaml' \) > "${files_tmp}"

  local total=0
  local file name job entry hr_count disable_sudo
  while IFS= read -r file; do
    strings::is_empty "${file}" && continue
    name="$(basename "${file}")"
    files::create_temp jobs_tmp
    yq eval '.jobs | keys | .[]' "${file}" > "${jobs_tmp}"
    while IFS= read -r job; do
      strings::is_empty "${job}" && continue
      entry="${name}:${job}"
      hr_count="$(harden_runner_count "${file}" "${job}")"
      if ((hr_count == 0)); then
        if arrays::contains "${entry}" "${exempt_entries[@]}"; then
          printf '%s\n' "${entry}" >> "${seen_tmp}"
          continue
        fi
        printf '%s: job %q has no harden-runner step\n' "${name}" "${job}" >&2
        total=$((total + 1))
        continue
      fi
      disable_sudo="$(harden_runner_with "${file}" "${job}" 'disable-sudo')"
      if arrays::contains "${entry}" "${exempt_entries[@]}"; then
        printf '%s\n' "${entry}" >> "${seen_tmp}"
        if [[ "${disable_sudo}" == 'true' ]]; then
          printf 'stale EXEMPT entry: %s already sets disable-sudo: true\n' "${entry}" >&2
          total=$((total + 1))
        fi
        continue
      fi
      if [[ "${disable_sudo}" != 'true' ]]; then
        printf '%s: job %q sets disable-sudo %q, want true\n' "${name}" "${job}" "${disable_sudo}" >&2
        total=$((total + 1))
      fi
    done < "${jobs_tmp}"
  done < "${files_tmp}"

  local exempt_entry
  for exempt_entry in ${exempt_entries[@]+"${exempt_entries[@]}"}; do
    if ! grep --quiet --line-regexp --fixed-strings "${exempt_entry}" "${seen_tmp}"; then
      printf 'stale EXEMPT entry: %s matches no job\n' "${exempt_entry}" >&2
      total=$((total + 1))
    fi
  done

  if ((total > 0)); then
    printf '%d job(s) not disabling sudo\n' "${total}" >&2
    exit 1
  fi
  exit 0
}

main "$@"
