#!/usr/bin/env bash

# @description Audit every shebang-bearing executable under non-interactive/,
#              interactive/, install/, set_up/, misc/, .ci/, and the project root AND every library file
#              under functions/ for the project's shdoc annotation convention.
#              Top-level scripts must carry a file-level `# @description` tag
#              in the header, an annotation block on every helper function
#              other than `main`, no scaffold placeholder text anywhere in the
#              header block, no placeholder text in any function's annotation
#              block either, and — unless they are a pass-through or a
#              standalone that never sources the library — a call to
#              args::handle_help_flag. Library files (functions/*.bash) must have
#              an annotation block on every function and no placeholder text in
#              those annotations — the file-level description is intentionally
#              not required because library files are documented
#              function-by-function.
# @noargs
# @stderr Empty on success. On failure: one block per failing file with the
#         missing-header reason and any unannotated function names.
# @exitcode 0 every in-scope file passes the appropriate annotation rule.
# @exitcode 1 one or more files are missing required shdoc annotations.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

# @description Print every in-scope top-level script path, one per line.
#              In-scope means any shebang-bearing file under scripts/{non-interactive,
#              interactive,install,set_up,misc}, .ci/, or directly under the repo root.
#              Every scan root derives from REPO_DIR — the repo this command was
#              invoked in — never from the SCRIPTS_DIR environment variable, which
#              points at the user's main checkout and would make the audit grade the
#              wrong tree from a worktree or a second clone.
#              Library files under functions/ are listed by collect_library_files
#              instead, since they follow a different annotation rule.
# @noargs
# @stdout File paths, one per line.
# shellcheck disable=SC2120 # called with no args by callers, shellcheck can't see all call sites
function collect_in_scope_scripts() {
  args::check_no_args "$@"
  local subdir
  for subdir in non-interactive interactive install set_up misc; do
    if dirs::exists "${REPO_DIR}/scripts/${subdir}"; then
      shell_scripts::find "${REPO_DIR}/scripts/${subdir}"
    fi
  done
  if dirs::exists "${REPO_DIR}/.ci"; then
    shell_scripts::find "${REPO_DIR}/.ci"
  fi
  shell_scripts::find_root_only
}

# @description Print every library file path under functions/, one per line.
#              Library files are audited under a different rule than top-level
#              scripts: per-function annotations only, no file-level
#              @description.
# @noargs
# @stdout File paths, one per line.
# shellcheck disable=SC2120 # called with no args by callers
function collect_library_files() {
  args::check_no_args "$@"
  local file
  for file in "${REPO_DIR}"/scripts/functions/*.bash; do
    if files::exists "${file}"; then
      printf '%s\n' "${file}"
    fi
  done
}

# @description Audit a single top-level script. Print a report block on stdout
#              if it lacks a file-level @description or has any unannotated
#              helper functions other than `main`; print nothing when it is
#              clean, so the caller decides by whether output appeared.
#
#              A producer rather than a predicate returning 0/1. As a predicate
#              it would be called from an `if`, which disables errexit for its
#              whole call tree — so a failure in the awk that enumerates
#              functions would yield no output and read as "this file is clean".
#              Called as a plain command, that failure aborts the lint.
# @arg $1 file path to script
# @stdout A file-name line followed by one `  - reason` line per violation.
function audit_one() {
  args::check_exactly_1_arg "$@"
  local -r file="$1"
  local violations=()
  if ! shdoc::file_has_description "${file}"; then
    violations+=('missing file-level @description')
  fi
  if shdoc::header_has_placeholder "${file}"; then
    violations+=('placeholder TODO text in shdoc header')
  fi
  if shell_scripts::requires_help_flag "${file}" \
    && ! grep --quiet --extended-regexp '^[[:space:]]*args::handle_help_flag([[:space:]]|$)' "${file}"; then
    violations+=('missing args::handle_help_flag call')
  fi
  local unannotated_file
  files::create_temp unannotated_file
  shdoc::find_unannotated_functions "${file}" > "${unannotated_file}"
  if [[ -s "${unannotated_file}" ]]; then
    local fn
    while IFS= read -r fn; do
      violations+=("helper function missing shdoc annotation: ${fn}")
    done < "${unannotated_file}"
  fi
  local placeholder_file
  files::create_temp placeholder_file
  shdoc::find_placeholder_functions "${file}" > "${placeholder_file}"
  if [[ -s "${placeholder_file}" ]]; then
    local placeholder_fn
    while IFS= read -r placeholder_fn; do
      violations+=("function annotation contains placeholder text: ${placeholder_fn}")
    done < "${placeholder_file}"
  fi
  if [[ "${#violations[@]}" -eq 0 ]]; then
    return
  fi
  printf '%s\n' "${file}"
  local v
  for v in "${violations[@]}"; do
    printf '  - %s\n' "${v}"
  done
}

# @description Audit a single library file under functions/. Library files
#              are documented per-function, so the file-level @description
#              check is skipped — unannotated functions and annotation blocks
#              carrying placeholder text are both flagged. A producer, for the
#              same reason as audit_one above.
# @arg $1 file path to library file
# @stdout A file-name line followed by one `  - reason` line per violation.
function audit_library_one() {
  args::check_exactly_1_arg "$@"
  local -r file="$1"
  local violations=()
  local unannotated_file
  files::create_temp unannotated_file
  shdoc::find_unannotated_functions "${file}" > "${unannotated_file}"
  if [[ -s "${unannotated_file}" ]]; then
    local fn
    while IFS= read -r fn; do
      violations+=("function missing shdoc annotation: ${fn}")
    done < "${unannotated_file}"
  fi
  local placeholder_file
  files::create_temp placeholder_file
  shdoc::find_placeholder_functions "${file}" > "${placeholder_file}"
  if [[ -s "${placeholder_file}" ]]; then
    local placeholder_fn
    while IFS= read -r placeholder_fn; do
      violations+=("function annotation contains placeholder text: ${placeholder_fn}")
    done < "${placeholder_file}"
  fi
  if [[ "${#violations[@]}" -eq 0 ]]; then
    return
  fi
  printf '%s\n' "${file}"
  local v
  for v in "${violations[@]}"; do
    printf '  - %s\n' "${v}"
  done
}

function main() {
  args::check_no_args "$@"
  local rc=0

  # The two audit helpers are plain commands here, not `if` conditions: an `if`
  # would disable errexit through their whole call tree and turn a failed awk
  # into a clean report.
  local report_tmp
  files::create_temp report_tmp

  local scripts_file
  files::create_temp scripts_file
  # shellcheck disable=SC2119 # no args intended; SC2120 disable on function def suppresses the pair
  collect_in_scope_scripts > "${scripts_file}"
  local script
  while IFS= read -r script; do
    audit_one "${script}" > "${report_tmp}"
    if [[ -s "${report_tmp}" ]]; then
      cat "${report_tmp}" >&2
      rc=1
    fi
  done < "${scripts_file}"

  local lib_file
  files::create_temp lib_file
  # shellcheck disable=SC2119 # no args intended
  collect_library_files > "${lib_file}"
  local lib
  while IFS= read -r lib; do
    audit_library_one "${lib}" > "${report_tmp}"
    if [[ -s "${report_tmp}" ]]; then
      cat "${report_tmp}" >&2
      rc=1
    fi
  done < "${lib_file}"

  if ((rc != 0)); then
    log::warn 'shdoc header audit failed — see above for details.'
  fi
  exit "${rc}"
}

main "$@"
