#!/usr/bin/env bash

# @description Assert every script in scope has a paired BATS test file. Three
#              scopes are checked: every shebang-bearing executable under .ci/
#              needs test/ci/<name>.bats, every executable shell file at the
#              repo root — the runners every contributor and every CI job
#              invokes — needs test/root/<name>.bats, and every tracked git hook
#              under .githooks/ needs test/ci/<name>.bats. Mirrors the BATS-coverage
#              mandate that already applies to functions/*.bash. Explicitly
#              side-effecting scripts that cannot be deterministically tested are
#              exempted via a hardcoded list per scope, and each exemption must
#              stay warranted: an entry naming no script in its scope, or naming
#              one that does have a paired test, fails the lint rather than
#              silently disarming it.
# @noargs
# @stderr One line per script missing its paired test, and one per stale exemption.
# @exitcode 0 every non-exempt script in both scopes has a paired test.
# @exitcode 1 one or more scripts are missing a paired test, or an EXEMPT entry is stale.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly CI_DIR="${CI_DIR_OVERRIDE:-${REPO_DIR}/.ci}"
readonly TEST_CI_DIR="${TEST_CI_DIR_OVERRIDE:-${REPO_DIR}/test/ci}"
readonly ROOT_DIR="${ROOT_DIR_OVERRIDE:-${REPO_DIR}}"
readonly TEST_ROOT_DIR="${TEST_ROOT_DIR_OVERRIDE:-${REPO_DIR}/test/root}"
readonly HOOKS_DIR="${HOOKS_DIR_OVERRIDE:-${REPO_DIR}/.githooks}"

# Scripts under .ci/ exempt from the paired-test mandate. Deliberately empty:
# all .ci scripts have paired tests under test/ci/. apply-repo-settings was the
# last holdout, on the grounds that it mutates the live GitHub repo via gh and
# so had "nothing deterministic to assert" — untrue: shimming gh pins the API
# calls it issues and its create-vs-update ruleset branch. An entry here that
# names no script, or names one that does have a test, fails the lint rather
# than silently disarming it.
readonly EXEMPT=()

# Repo-root runners exempt from the mandate. Deliberately empty: all six
# runners have paired tests under test/root/. An entry here that names no
# runner, or names one that does have a test, fails the lint rather than
# silently disarming it.
readonly ROOT_EXEMPT=()

# Tracked git hooks exempt from the mandate. Deliberately empty: both hooks have
# paired tests under test/ci/. They were outside every scope until #321, which is
# how two load-bearing files — the Conventional Commits gate and the hook that
# installs the #248 fixture-escape defense before running the suite — came to be
# the only untested code in the gate tree. Same staleness detection as above.
readonly HOOKS_EXEMPT=()

# @description Print the basenames of entries directly inside dir that are
#              executable shell files. Non-recursive, so against the repo root it
#              yields the runner executables and not the scripts nested under
#              scripts/ or .ci/. Used for the repo-root and .githooks/ scopes;
#              the .ci/ scope goes through shell_scripts::find instead, which
#              recurses.
# @arg $1 dir directory to scan
# @stdout One basename per line; nothing when the directory holds no such files.
function executable_shell_names() {
  args::check_exactly_1_arg "$@"
  local -r root_dir="$1"
  local entry
  for entry in "${root_dir}"/*; do
    if files::is_executable "${entry}" && shell_scripts::is_shell_file "${entry}"; then
      basename "${entry}"
    fi
  done
}

# @description Check one scope: every non-exempt script needs a paired
#              <test_dir>/<name>.bats, and every exempt entry must still be
#              warranted.
# @arg $1 names_file file of script basenames, one per line
# @arg $2 test_dir directory expected to hold <name>.bats
# @arg $3 label display path used in messages, e.g. test/ci
# @arg $@ exempt remaining args are exempt basenames; may be none
# @stderr One line per violation.
# @exitcode 0 no violations in this scope.
# @exitcode 1 a missing paired test or a stale exemption.
function check_scope() {
  args::check_at_least_3_args "$@"
  local -r names_file="$1"
  local -r test_dir="$2"
  local -r label="$3"
  shift 3
  local -a exempt=("$@")
  local seen_tmp
  files::create_temp seen_tmp
  local failed=0
  local name
  while IFS= read -r name; do
    strings::is_empty "${name}" && continue
    if arrays::contains "${name}" ${exempt[@]+"${exempt[@]}"}; then
      printf '%s\n' "${name}" >> "${seen_tmp}"
      if files::exists "${test_dir}/${name}.bats"; then
        printf 'stale EXEMPT entry: %s already has a paired %s/%s.bats\n' \
          "${name}" "${label}" "${name}" >&2
        failed=1
      fi
      continue
    fi
    if ! files::exists "${test_dir}/${name}.bats"; then
      printf '%s: no paired %s/%s.bats\n' "${name}" "${label}" "${name}" >&2
      failed=1
    fi
  done < "${names_file}"
  local entry
  for entry in ${exempt[@]+"${exempt[@]}"}; do
    if ! grep --quiet --line-regexp --fixed-strings "${entry}" "${seen_tmp}"; then
      printf 'stale EXEMPT entry: %s matches no script in the %s scope\n' \
        "${entry}" "${label}" >&2
      failed=1
    fi
  done
  return "${failed}"
}

function main() {
  args::check_no_args "$@"
  local -a ci_exempt=() root_exempt=() hooks_exempt=()
  arrays::from_env_override ci_exempt EXEMPT_OVERRIDE "${EXEMPT[@]}"
  arrays::from_env_override root_exempt ROOT_EXEMPT_OVERRIDE ${ROOT_EXEMPT[@]+"${ROOT_EXEMPT[@]}"}
  arrays::from_env_override hooks_exempt HOOKS_EXEMPT_OVERRIDE ${HOOKS_EXEMPT[@]+"${HOOKS_EXEMPT[@]}"}

  local ci_scripts_tmp ci_names_tmp root_names_tmp hooks_names_tmp
  files::create_temp ci_scripts_tmp
  files::create_temp ci_names_tmp
  files::create_temp root_names_tmp
  files::create_temp hooks_names_tmp
  shell_scripts::find "${CI_DIR}" > "${ci_scripts_tmp}"
  local script
  while IFS= read -r script; do
    strings::is_empty "${script}" && continue
    basename "${script}" >> "${ci_names_tmp}"
  done < "${ci_scripts_tmp}"
  executable_shell_names "${ROOT_DIR}" > "${root_names_tmp}"
  executable_shell_names "${HOOKS_DIR}" > "${hooks_names_tmp}"

  local overall=0
  check_scope "${ci_names_tmp}" "${TEST_CI_DIR}" 'test/ci' \
    ${ci_exempt[@]+"${ci_exempt[@]}"} || overall=1
  check_scope "${root_names_tmp}" "${TEST_ROOT_DIR}" 'test/root' \
    ${root_exempt[@]+"${root_exempt[@]}"} || overall=1
  # The hooks land in test/ci/ rather than a test/githooks/ of their own: they are
  # gate code, the same thing every other file in that directory tests, and a
  # two-file directory would buy nothing but another scope to keep in sync.
  check_scope "${hooks_names_tmp}" "${TEST_CI_DIR}" 'test/ci' \
    ${hooks_exempt[@]+"${hooks_exempt[@]}"} || overall=1
  exit "${overall}"
}

main "$@"
