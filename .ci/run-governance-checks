#!/usr/bin/env bash

# @description Run every governance lint in sequence and aggregate exit codes.
#              The local equivalent of the per-check CI jobs; invoked by
#              `just governance` and the pre-push hook. Does NOT run formatting
#              or shellcheck — that is treefmt (`nix flake check`) and
#              `check-scripts`.
# @noargs
# @stderr Output from each failing check.
# @exitcode 0 every governance check passed.
# @exitcode 1 one or more governance checks failed.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0 (#290).
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

function main() {
  args::check_no_args "$@"
  local -r ci="${REPO_DIR}/.ci"
  local rc=0
  local check
  for check in \
    check-uses-sha-pinned \
    check-patch-tag-pins \
    check-min-permissions \
    check-harden-runner-first \
    check-harden-runner-egress \
    check-harden-runner-disable-sudo \
    check-links-allowed-endpoints \
    check-pr-workflows-no-secrets \
    check-codecov-strict \
    check-readme-workflow-table \
    check-renovate-invariants \
    check-required-checks-no-paths \
    check-protect-main \
    check-jsonschema \
    check-job-timeout-minutes \
    check-workflow-concurrency \
    check-pull-request-target-absent \
    check-checkout-persist-credentials \
    check-upload-artifact-strict \
    check-run-block-strict \
    check-script-has-test \
    check-vacuous-arity-tests \
    check-stderr-assertions \
    check-tree-scan-root \
    check-inherit-errexit \
    check-ci-job-in-summary \
    check-orphan-invariants \
    check-justfile-invariants \
    check-devshell-provides \
    check-tool-declarations; do
    log::log "running ${check}"
    "${ci}/${check}" || rc=1
  done
  if ((rc != 0)); then
    log::warn 'one or more governance checks failed'
  fi
  exit "${rc}"
}

main "$@"
