#!/usr/bin/env bash

# @description Assert every `codecov/codecov-action` step keeps the Codecov
#              CLI's integrity checking armed. With `fail_ci_if_error` false or
#              absent, codecov.sh's `exit_if_error` only prints and returns, so
#              a failed GPG signature check falls through to `chmod +x` and the
#              CLI runs with no verified provenance (#199), and a rejected
#              upload still reports green (#200). Three further inputs bypass
#              validation outright — `skip_validation`, `binary`, `use_pypi` —
#              so guarding `fail_ci_if_error` alone would leave three ways to
#              reintroduce the same hole.
#
#              Scans .github/actions/ as well as .github/workflows/. Moving a
#              codecov step into a composite action is the established way to
#              share it in this repo, and a workflow-only scan would let that
#              move carry the step out of the lint's reach (#291).
# @noargs
# @stderr One line per violation, plus a final count.
# @exitcode 0 every codecov-action step is strict.
# @exitcode 1 one or more codecov-action steps are not.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"
commands::assert_executable_exists 'yq'

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly WORKFLOWS_DIR="${WORKFLOWS_DIR_OVERRIDE:-${REPO_DIR}/.github/workflows}"
readonly ACTIONS_DIR="${ACTIONS_DIR_OVERRIDE:-${REPO_DIR}/.github/actions}"

# @description Emit one pipe-joined record per codecov-action step in a file:
#              kind|job|fail_ci_if_error|skip_validation|binary|use_pypi. `kind`
#              is `job` for a workflow step and `composite` for one under an
#              action's `.runs.steps`, which is the only structural difference
#              between the two files this lint reads. Values pass through
#              `tostring`, so an absent input reads as the literal `null`. Do NOT
#              rewrite this with yq's `//` operator: `//` returns its RHS when
#              the LHS is null OR false, which would render a real
#              `fail_ci_if_error: false` indistinguishable from an absent one.
#              mikefarah yq has no `if/then/else`.
#
#              `.jobs // {}` and `select(has("runs"))` make each shape
#              contribute nothing to the other kind of file rather than
#              erroring. A document that is neither — a root-level sequence, say
#              — still errors, and must: that is a file this lint cannot read,
#              and reporting it clean would be a false green (#290).
# @arg $1 file path to a workflow or composite-action YAML
# @stdout Zero or more `kind|job|v|v|v|v` records.
function codecov_steps() {
  args::check_exactly_1_arg "$@"
  local -r file="$1"
  # shellcheck disable=SC2016 # yq program literal; $ctx is yq syntax, not shell
  yq eval '
    [ (.jobs // {} | to_entries | .[] | {"kind": "job", "name": .key, "steps": .value.steps}),
      (select(has("runs")) | {"kind": "composite", "name": "", "steps": .runs.steps}) ]
    | .[] as $ctx
    | $ctx.steps[]
    | select((.uses // "") | test("^codecov/codecov-action@"))
    | [$ctx.kind,
       $ctx.name,
       (.with.fail_ci_if_error | tostring),
       (.with.skip_validation | tostring),
       (.with.binary | tostring),
       (.with.use_pypi | tostring)]
    | join("|")
  ' "${file}"
}

# @description Scan one file for non-strict codecov-action steps. Prints
#              violations to stderr; echoes the violation count to stdout. A
#              workflow violation names the job it is in; a composite one names
#              only the file, because a composite action has no job to name.
# @arg $1 file path to a workflow or composite-action YAML
# @stdout integer violation count
function scan_codecov() {
  args::check_exactly_1_arg "$@"
  local -r file="$1"
  local records_tmp
  files::create_temp records_tmp
  codecov_steps "${file}" > "${records_tmp}"
  local count=0
  local kind job where fail_ci skip_val binary use_pypi
  while IFS='|' read -r kind job fail_ci skip_val binary use_pypi; do
    strings::is_empty "${kind}" && continue
    if [[ "${kind}" == 'job' ]]; then
      where="${file}: job ${job}"
    else
      where="${file}"
    fi
    if [[ "${fail_ci}" != 'true' ]]; then
      printf '%s: fail_ci_if_error must be true (found: %s)\n' \
        "${where}" "${fail_ci}" >&2
      count=$((count + 1))
    fi
    if [[ "${skip_val}" == 'true' ]]; then
      printf '%s: skip_validation bypasses CLI integrity checking\n' "${where}" >&2
      count=$((count + 1))
    fi
    if [[ "${binary}" != 'null' ]]; then
      printf '%s: binary bypasses CLI integrity checking (found: %s)\n' \
        "${where}" "${binary}" >&2
      count=$((count + 1))
    fi
    if [[ "${use_pypi}" == 'true' ]]; then
      printf '%s: use_pypi bypasses CLI integrity checking\n' "${where}" >&2
      count=$((count + 1))
    fi
  done < "${records_tmp}"
  printf '%s\n' "${count}"
}

function main() {
  args::check_no_args "$@"
  local files_tmp
  files::create_temp files_tmp
  local dir
  for dir in "${WORKFLOWS_DIR}" "${ACTIONS_DIR}"; do
    dirs::exists "${dir}" || continue
    # -name globs have no long-form equivalent in find.
    find "${dir}" -type f \( -name '*.yml' -o -name '*.yaml' \) >> "${files_tmp}"
  done
  local total=0
  local file n
  while IFS= read -r file; do
    strings::is_empty "${file}" && continue
    n="$(scan_codecov "${file}")"
    total=$((total + n))
  done < "${files_tmp}"
  if ((total > 0)); then
    printf '%d codecov-action violation(s)\n' "${total}" >&2
    exit 1
  fi
  exit 0
}

main "$@"
