#!/usr/bin/env bash

# @description Audit file modes against the repo's executable-bit convention.
#              Shebang-bearing scripts under scripts/non-interactive/,
#              scripts/interactive/, scripts/misc/, .ci/, .githooks/, and the
#              repo root must be executable. Library and test files (*.bash,
#              *.bats) must not be. scripts/install/ and scripts/set_up/ are
#              skipped entirely: removing the executable bit is the documented
#              way to gate a script from those runners. Every other directory
#              is out of scope.
# @noargs
# @stderr One line per violation, plus a summary warning when any are found.
# @exitcode 0 every in-scope file's mode matches the convention.
# @exitcode 1 one or more files have the wrong mode.

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

# .ci/ lives at the repo root, not under SCRIPTS_DIR (= repo-root/scripts).
REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# Scripts intentionally gated off from the install/set_up runners by having their
# executable bit removed. Re-enable one by chmod +x AND removing it from here.
# Kept central rather than as in-file markers so "what is currently disabled?"
# is answerable from one place, following the EXEMPT array precedent in
# .ci/check-script-has-test and .ci/check-orphan-invariants.
readonly GATED=(
  scripts/set_up/docker/enable-rootless-docker
  scripts/set_up/sysctl/copy-sysctl-rootless-docker-file
  scripts/set_up/tailscale/set-tailscale-netfilter-mode
)

# @description Report a violation when a file that must be executable is not.
#              Files with no shell shebang are exempt: shfmt --find also matches
#              by extension, so a .sh file with no shebang can reach the
#              classifier and has no reason to carry the bit.
# @arg $1 file absolute path to the file
# @arg $2 reason short phrase naming why the file must be executable
# @stderr One line naming the file when it violates the rule.
# @exitcode 0 compliant, or exempt because the file has no shebang
# @exitcode 1 the file must be executable but is not
function assert_executable() {
  args::check_exactly_2_args "$@"
  local -r file="$1"
  local -r reason="$2"
  if ! shell_scripts::has_shell_shebang "${file}"; then
    return 0
  fi
  if files::is_executable "${file}"; then
    return 0
  fi
  printf '%s: must be executable (%s)\n' "${file#"${REPO_DIR}/"}" "${reason}" >&2
  return 1
}

# @description Report a violation when a file that must not be executable is.
#              No shebang gate here: .bats files start with a function, not a
#              shebang, and they are exactly what this rule exists to cover.
# @arg $1 file absolute path to the file
# @arg $2 reason short phrase naming why the file must not be executable
# @stderr One line naming the file when it violates the rule.
# @exitcode 0 compliant
# @exitcode 1 the file must not be executable but is
function assert_not_executable() {
  args::check_exactly_2_args "$@"
  local -r file="$1"
  local -r reason="$2"
  if ! files::is_executable "${file}"; then
    return 0
  fi
  printf '%s: must not be executable (%s)\n' "${file#"${REPO_DIR}/"}" "${reason}" >&2
  return 1
}

function main() {
  args::check_no_args "$@"
  local candidates_file
  files::create_temp candidates_file
  # shellcheck disable=SC2154 # candidates_file set via nameref inside files::create_temp
  shell_scripts::find > "${candidates_file}"
  local rc=0
  local file relative
  while IFS= read -r file; do
    if strings::is_empty "${file}"; then
      continue
    fi
    relative="${file#"${REPO_DIR}/"}"
    # First match wins; see issue #171 and the "Preserving the executable bit"
    # section of CLAUDE.md for why each arm is ordered where it is.
    case "${relative}" in
      *.bash | *.bats)
        assert_not_executable "${file}" 'library or test file' || rc=1
        ;;
      scripts/install/* | scripts/set_up/*)
        # Must be executable unless explicitly gated. Deliberately AFTER the
        # library rule: a *.bash under install/ is a library file and must stay
        # non-executable, so this arm must not claim it. See issue #173 for the
        # measurement behind enforcing here at all.
        if arrays::contains "${relative}" "${GATED[@]}"; then
          continue
        fi
        assert_executable "${file}" 'install/set_up runner script' || rc=1
        ;;
      scripts/non-interactive/* | scripts/interactive/* | scripts/misc/* | .ci/* | .githooks/*)
        assert_executable "${file}" "script under ${relative%/*}/" || rc=1
        ;;
      */*)
        # Every other subdirectory is out of scope.
        continue
        ;;
      *)
        assert_executable "${file}" 'repo-root runner' || rc=1
        ;;
    esac
  done < "${candidates_file}"
  if ((rc != 0)); then
    log::warn 'executable-bit audit failed — see above for details.'
  fi
  exit "${rc}"
}

main "$@"
