#!/usr/bin/env bash

# @description Audit file modes against the repo's executable-bit convention.
#              Shebang-bearing scripts under scripts/non-interactive/,
#              scripts/interactive/, scripts/misc/, scripts/other/, .ci/,
#              .githooks/, and the repo root must be executable. So must scripts
#              under scripts/install/ and scripts/set_up/, unless listed in the
#              GATED allowlist — removing the exec bit is how a script is gated
#              off from those runners, so the exceptions are enumerated rather
#              than the directories skipped. Every GATED entry must itself exist
#              and be non-executable, so a stale line cannot silently disarm the
#              lint. Library and test files (*.bash, *.bats) must not be
#              executable — except under scripts/other/, where the
#              must-be-executable rule wins, since we impose no naming
#              conventions on third-party content. Every other directory is out
#              of scope.
# @noargs
# @stderr One line per violation, plus a summary warning when any are found.
# @exitcode 0 every in-scope file's mode matches the convention.
# @exitcode 1 one or more files have the wrong mode.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0 (#290).
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

# .ci/ lives at the repo root, not under SCRIPTS_DIR (= repo-root/scripts).
REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# Scripts intentionally gated off from the install/set_up runners by having their
# executable bit removed. Re-enable one by chmod +x AND removing it from here.
# Kept central rather than as in-file markers so "what is currently disabled?"
# is answerable from one place, following the EXEMPT array precedent in
# .ci/check-script-has-test and .ci/check-orphan-invariants.
# Entries must live under scripts/install/ or scripts/set_up/: only that arm
# consults this list, so an entry anywhere else would be required to carry the
# exec bit by its own arm and to lack it by assert_gated_entries_current — an
# unsatisfiable pair that makes the lint permanently fail.
readonly GATED=(
  scripts/set_up/docker/enable-rootless-docker
  scripts/set_up/sysctl/copy-sysctl-rootless-docker-file
  scripts/set_up/tailscale/set-tailscale-netfilter-mode
)

# @description Report a violation when a file that must be executable is not.
#              Files with no shell shebang are exempt: shfmt --find also matches
#              by extension, so a .sh file with no shebang can reach the
#              classifier and has no reason to carry the bit.
# @arg $1 file absolute path to the file
# @arg $2 reason short phrase naming why the file must be executable
# @stderr One line naming the file when it violates the rule.
# @exitcode 0 compliant, or exempt because the file has no shebang
# @exitcode 1 the file must be executable but is not
function assert_executable() {
  args::check_exactly_2_args "$@"
  local -r file="$1"
  local -r reason="$2"
  if ! shell_scripts::has_shell_shebang "${file}"; then
    return 0
  fi
  if files::is_executable "${file}"; then
    return 0
  fi
  printf '%s: must be executable (%s)\n' "${file#"${REPO_DIR}/"}" "${reason}" >&2
  return 1
}

# @description Report a violation when a file that must not be executable is.
#              No shebang gate here: .bats files start with a function, not a
#              shebang, and they are exactly what this rule exists to cover.
# @arg $1 file absolute path to the file
# @arg $2 reason short phrase naming why the file must not be executable
# @stderr One line naming the file when it violates the rule.
# @exitcode 0 compliant
# @exitcode 1 the file must not be executable but is
function assert_not_executable() {
  args::check_exactly_2_args "$@"
  local -r file="$1"
  local -r reason="$2"
  if ! files::is_executable "${file}"; then
    return 0
  fi
  printf '%s: must not be executable (%s)\n' "${file#"${REPO_DIR}/"}" "${reason}" >&2
  return 1
}

# @description Report violations for stale GATED entries. An entry whose file no
#              longer exists, or one that has been re-enabled with chmod +x but
#              left in the array, silently shrinks the enforced set — the drift
#              failure mode the central allowlist trades for centralization.
# @noargs
# @stderr One line per stale entry, naming it and the reason.
# @exitcode 0 every GATED entry exists and is non-executable
# @exitcode 1 one or more entries are stale
# shellcheck disable=SC2120,SC2119 # function takes no args; args::check_no_args enforces that
function assert_gated_entries_current() {
  args::check_no_args "$@"
  local gated_rc=0
  local entry path
  for entry in "${GATED[@]}"; do
    path="${REPO_DIR}/${entry}"
    if ! files::exists "${path}"; then
      printf '%s: gated entry does not exist (remove it from GATED)\n' "${entry}" >&2
      gated_rc=1
    elif files::is_executable "${path}"; then
      printf '%s: gated entry is executable (remove it from GATED)\n' "${entry}" >&2
      gated_rc=1
    fi
  done
  return "${gated_rc}"
}

function main() {
  args::check_no_args "$@"
  local candidates_file
  files::create_temp candidates_file
  # shellcheck disable=SC2154 # candidates_file set via nameref inside files::create_temp
  shell_scripts::find > "${candidates_file}"
  # scripts/other/ is excluded from shell_scripts::find's no-arg scan, correctly:
  # the shellcheck, shfmt, and shdoc audits must all skip third-party files. The
  # mode lint is the one linter that needs to see in, because other/ is always on
  # PATH. Given a directory argument, shell_scripts::find takes its `shfmt --find`
  # branch and never applies that exclusion regex, so the helper needs no change.
  # REPO_DIR-relative, not SCRIPTS_DIR-relative: the whole classifier works in
  # REPO_DIR terms, and the BATS fixture deliberately leaves SCRIPTS_DIR pointing
  # at the real repo. See issue #175.
  if dirs::exists "${REPO_DIR}/scripts/other"; then
    shell_scripts::find "${REPO_DIR}/scripts/other" >> "${candidates_file}"
  fi
  local rc=0
  local file relative
  while IFS= read -r file; do
    if strings::is_empty "${file}"; then
      continue
    fi
    relative="${file#"${REPO_DIR}/"}"
    # First match wins; see issue #171 and the "Preserving the executable bit"
    # section of CLAUDE.md for why each arm is ordered where it is.
    case "${relative}" in
      scripts/other/*)
        # Always on PATH, so a stripped bit breaks it exactly as under
        # non-interactive/. Deliberately ahead of the library rule: third-party
        # files get this one rule from us and no naming conventions imposed on
        # content we never modify. See issue #175.
        assert_executable "${file}" 'script under scripts/other/ (always on PATH)' || rc=1
        ;;
      *.bash | *.bats)
        assert_not_executable "${file}" 'library or test file' || rc=1
        ;;
      scripts/install/* | scripts/set_up/*)
        # Must be executable unless explicitly gated. Deliberately AFTER the
        # library rule: a *.bash under install/ is a library file and must stay
        # non-executable, so this arm must not claim it. See issue #173 for the
        # measurement behind enforcing here at all.
        if arrays::contains "${relative}" "${GATED[@]}"; then
          continue
        fi
        assert_executable "${file}" 'install/set_up runner script' || rc=1
        ;;
      scripts/non-interactive/* | scripts/interactive/* | scripts/misc/* | .ci/* | .githooks/*)
        assert_executable "${file}" "script under ${relative%/*}/" || rc=1
        ;;
      */*)
        # Every other subdirectory is out of scope.
        continue
        ;;
      *)
        assert_executable "${file}" 'repo-root runner' || rc=1
        ;;
    esac
  done < "${candidates_file}"
  # Runs outside the loop: a stale GATED entry is a property of the array, not
  # of any file the classifier visited — a deleted entry is never visited at all.
  assert_gated_entries_current || rc=1
  if ((rc != 0)); then
    log::warn 'executable-bit audit failed — see above for details.'
  fi
  exit "${rc}"
}

main "$@"
