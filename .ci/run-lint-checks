#!/usr/bin/env bash

# @description Run every config/markup lint (actionlint, yamllint, JSON parse,
#              markdownlint-cli2, typos, editorconfig-checker) in sequence, then
#              build the docs site via .ci/build-site, aggregating exit codes.
#              The local equivalent of the former per-tool CI lint jobs; invoked
#              by `just lint`, the pre-push hook, and the CI `lint` job. Does NOT
#              run shellcheck/shdoc (that is check-scripts) or formatting (that
#              is treefmt via `nix flake check`).
#
#              With IN_DEVSHELL unset, as in an interactive `nix develop` or
#              direnv shell, it first re-runs itself through .ci/in-devshell,
#              so no tool resolves from the host PATH.
# @noargs
# @stderr Output from each failing lint, and the docs build's progress lines.
# @exitcode 0 every lint passed and the docs site built.
# @exitcode 1 one or more lints failed, or the docs build failed.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# The repo root is this file's own canonical path with its depth in the repo
# stripped, never the caller's working directory: run through a symlink, from a
# subdirectory, or from inside another repository, the gate still grades the
# repository it belongs to.
SELF_PATH="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
SELF_REPO="${SELF_PATH%/*/*}"

# An interactive `nix develop` or direnv shell leaves IN_DEVSHELL unset and the
# host PATH behind the flake's tools, so a tool the flake lacks would resolve from
# the host. Re-run through .ci/in-devshell, which sets IN_DEVSHELL and so stops
# the recursion. Above the `source` on purpose: SCRIPTS_DIR may be unset out
# here, and the devShell sets it. Inline [[ -z ]] rather than strings::is_empty
# for the same reason: the function library is not loaded yet. Outside the
# devShell nothing but bash, git, GNU coreutils and nix is assumed.
if [[ -z "${IN_DEVSHELL:-}" ]]; then
  exec "${SELF_REPO}/.ci/in-devshell" "${SELF_PATH}" "$@"
fi

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

REPO_DIR="${SELF_REPO}"
readonly REPO_DIR
# Every tool below, and the docs build, finds its files from the working
# directory, so they all run from the repo root.
cd -- "${REPO_DIR}"

function main() {
  args::check_no_args "$@"
  local rc=0
  # Aggregate rather than fail-fast so one run surfaces every category. Each
  # tool runs from the repo root; `|| rc=1` keeps set -e from aborting early.
  log::log 'running actionlint'
  actionlint || rc=1
  log::log 'running yamllint'
  # Lint the tracked YAML set, for the same reason markdownlint does below:
  # `yamllint .` walks the whole working tree, and unlike typos and
  # editorconfig-checker it does not skip gitignored paths. Any gitignored YAML
  # — an agent worktree under .claude/worktrees/, .direnv, scratch output —
  # would therefore fail the local gate while CI, which checks out clean, stays
  # green. That is the local/CI divergence this runner exists to prevent.
  # .yamllint.yml's `ignore:` list still applies: yamllint honors it for
  # explicitly-passed paths too, so it keeps guarding tracked files under lib/
  # and scripts/other/.
  local yaml_tmp
  files::create_temp yaml_tmp
  git ls-files -z -- '*.yml' '*.yaml' > "${yaml_tmp}"
  xargs --null --no-run-if-empty yamllint < "${yaml_tmp}" || rc=1
  log::log 'running json lint'
  # Inlined rather than a lint_json helper called as `lint_json || rc=1`: that
  # shape disables errexit through the helper's whole call tree, so a failing
  # `find` leaves an empty list, `--no-run-if-empty` runs nothing, and every
  # JSON file goes unlinted while the step reports success. Inline, only the
  # xargs status — the one that means "a JSON file is malformed" — reaches the
  # accumulator, matching the yamllint and markdownlint steps around it.
  local json_tmp
  files::create_temp json_tmp
  # -name has no long-form equivalent in find.
  find "${REPO_DIR}/.github" -name '*.json' -print0 > "${json_tmp}"
  xargs --null --no-run-if-empty --max-args=1 jq empty < "${json_tmp}" || rc=1
  log::log 'running markdownlint-cli2'
  # Lint the tracked markdown set — exactly what CI's clean, submodule-less
  # checkout sees. Globbing the working tree would pull in gitignored scratch
  # and .direnv, which markdownlint-cli2 does not skip; git ls-files avoids
  # that and omits submodules natively.
  local md_tmp
  files::create_temp md_tmp
  git ls-files -z -- '*.md' > "${md_tmp}"
  xargs --null --no-run-if-empty markdownlint-cli2 < "${md_tmp}" || rc=1
  log::log 'running typos'
  typos || rc=1
  log::log 'running editorconfig-checker'
  editorconfig-checker || rc=1
  # Last on purpose. The docs build writes generated markdown into .docs/ and a
  # rendered site into site/; running it after the linters keeps that output out
  # of reach of anything that walks the tree. It is also the only step here that
  # is a build rather than a lint, and it lives in this suite because that is
  # what puts `mkdocs build --strict` behind the local gate, the pre-push hook,
  # and the required CI lint job at once.
  log::log 'building the docs site'
  "${REPO_DIR}/.ci/build-site" || rc=1
  if ((rc != 0)); then
    log::warn 'one or more lint checks failed'
  fi
  exit "${rc}"
}

main "$@"
