#!/usr/bin/env bash

# @description Enforce parity between the secrets the workflows and local
#              actions read and the secrets runbook (.docs/secrets.md). Every
#              `secrets.NAME` or `secrets['NAME']` reference under
#              .github/workflows/ and .github/actions/ (outside YAML comment
#              lines, GITHUB_TOKEN excepted) must have a `## NAME` section in the
#              runbook, and every `## NAME` section must name a secret something
#              reads. Only names are compared; section contents are not checked.
# @noargs
# @stderr One line per undocumented secret, stale section, or empty set.
# @exitcode 0 the used and documented secret sets are equal.
# @exitcode 1 a set differs or is empty, or an input path is missing.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"
commands::assert_executable_exists 'gawk'

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly SECRETS_MD="${SECRETS_MD_OVERRIDE:-${REPO_DIR}/.docs/secrets.md}"
readonly WORKFLOWS_DIR="${WORKFLOWS_DIR_OVERRIDE:-${REPO_DIR}/.github/workflows}"
readonly ACTIONS_DIR="${ACTIONS_DIR_OVERRIDE:-${REPO_DIR}/.github/actions}"

# @description Print the name of every secret referenced by a YAML file under
#              the given directory, one per line, GITHUB_TOKEN excluded. Both the
#              dot form and the quoted bracket form count; lines that are wholly
#              a YAML comment do not.
# @arg $1 dir directory to scan recursively for *.yml and *.yaml files
# @stdout One secret name per line (unsorted, may contain duplicates).
function used_secrets() {
  args::check_exactly_1_arg "$@"
  local -r dir="$1"
  local files_tmp
  files::create_temp files_tmp
  # -name globs have no long-form equivalent in find.
  # shellcheck disable=SC2154 # files_tmp assigned by files::create_temp via nameref
  find "${dir}" -type f \( -name '*.yml' -o -name '*.yaml' \) > "${files_tmp}"
  local file
  while IFS= read -r file; do
    strings::is_empty "${file}" && continue
    # \047 is a single quote: a literal one cannot sit inside this
    # single-quoted program.
    gawk '
      /^[[:space:]]*#/ { next }
      {
        rest = $0
        while (match(rest, /secrets(\.[A-Za-z_][A-Za-z0-9_]*|\[[\047"][A-Za-z_][A-Za-z0-9_]*[\047"]\])/)) {
          name = substr(rest, RSTART + 8, RLENGTH - 8)
          rest = substr(rest, RSTART + RLENGTH)
          gsub(/[\047"\]]/, "", name)
          if (name != "GITHUB_TOKEN") { print name }
        }
      }
    ' "${file}"
  done < "${files_tmp}"
}

# @description Print the secret name of every `## NAME` section in the runbook,
#              one per line. A level-2 heading counts only when it is a single
#              upper-case identifier, so prose headings are ignored.
# @arg $1 md path to the secrets runbook
# @stdout One secret name per line.
function documented_secrets() {
  args::check_exactly_1_arg "$@"
  local -r md="$1"
  gawk '
    /^## [A-Z][A-Z0-9_]*[[:space:]]*$/ {
      name = substr($0, 4)
      sub(/[[:space:]]+$/, "", name)
      print name
    }
  ' "${md}"
}

function main() {
  args::check_no_args "$@"
  files::assert_exists "${SECRETS_MD}"
  dirs::assert_exists "${WORKFLOWS_DIR}"
  dirs::assert_exists "${ACTIONS_DIR}"

  local used_tmp documented_tmp diff_tmp
  files::create_temp used_tmp
  files::create_temp documented_tmp
  files::create_temp diff_tmp
  # shellcheck disable=SC2154 # temps assigned by files::create_temp via nameref
  {
    used_secrets "${WORKFLOWS_DIR}"
    used_secrets "${ACTIONS_DIR}"
  } | sort --unique > "${used_tmp}"
  documented_secrets "${SECRETS_MD}" | sort --unique > "${documented_tmp}"

  local rc=0
  if files::is_empty "${used_tmp}"; then
    printf 'no secret references found under .github/workflows or .github/actions\n' >&2
    rc=1
  fi
  if files::is_empty "${documented_tmp}"; then
    printf 'no secret sections found in .docs/secrets.md\n' >&2
    rc=1
  fi

  local name
  comm -23 "${used_tmp}" "${documented_tmp}" > "${diff_tmp}" # no long-form equivalent
  while IFS= read -r name; do
    printf "undocumented secret: %s (add a '## %s' section to .docs/secrets.md)\n" "${name}" "${name}" >&2
    rc=1
  done < "${diff_tmp}"
  comm -13 "${used_tmp}" "${documented_tmp}" > "${diff_tmp}" # no long-form equivalent
  while IFS= read -r name; do
    printf 'stale secret entry: %s is documented but no workflow or action reads it\n' "${name}" >&2
    rc=1
  done < "${diff_tmp}"

  if ((rc != 0)); then
    log::warn 'secrets audit failed — keep .docs/secrets.md in step with the secrets workflows read.'
  fi
  exit "${rc}"
}

main "$@"
