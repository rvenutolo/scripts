#!/usr/bin/env bash

# @description Run the BATS suites listed in .ci/test-suites in parallel, or
#              forward arguments directly to bats.
# @arg $@ args Optional bats arguments or test file paths; omit to run every
#         suite listed in .ci/test-suites.
# @exitcode 0 all tests passed and the repo was left untouched.
# @exitcode 1 bats, flock, or GNU parallel not found, .ci/test-suites missing, one or more tests failed, or the suite mutated the repo.

set -Eeuo pipefail
# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and this gate exits 0.
shopt -s inherit_errexit
IFS=$'\n\t'

#shellcheck disable=SC1091
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
# pass-through: any arg count valid (forwarded to bats)

# test/ lives at the repo root, not under SCRIPTS_DIR (= repo-root/scripts).
REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
readonly SUITES_FILE="${REPO_DIR}/.ci/test-suites"

# @description Print the absolute path of each suite root listed in .ci/test-suites,
#              one per line, skipping blank lines and # comments. Read only when no
#              arguments are given, so the tool guards and pass-through runs do not
#              depend on the file.
# @noargs
# @stdout One absolute suite root per line.
# @exitcode 1 .ci/test-suites does not exist.
# shellcheck disable=SC2120 # called with no args by main, but shellcheck can't see the call site
function default_targets() {
  args::check_no_args "$@"
  local suites_tmp
  files::create_temp suites_tmp
  # shellcheck disable=SC2154 # suites_tmp assigned by files::create_temp via nameref
  files::data_lines "${SUITES_FILE}" > "${suites_tmp}"
  local suite
  while IFS= read -r suite; do
    printf '%s/%s\n' "${REPO_DIR}" "${suite}"
  done < "${suites_tmp}"
}

# @description Print one line per watched repo artifact: HEAD sha, config hash, index hash.
#              Used before/after the suite to detect fixture escapes onto the real repo.
# @noargs
# shellcheck disable=SC2120 # called with no args by main, but shellcheck can't see the call site
function repo_state() {
  args::check_no_args "$@"
  local head_ref config_hash index_hash
  # An empty repo has no HEAD; --quiet --verify prints nothing, so substitute a marker.
  head_ref="$(git rev-parse --quiet --verify HEAD || printf 'NO-HEAD')"
  config_hash="$(files::hash_if_exists "$(git rev-parse --path-format=absolute --git-path config)")"
  index_hash="$(files::hash_if_exists "$(git rev-parse --path-format=absolute --git-path index)")"
  printf 'HEAD=%s\nconfig=%s\nindex=%s\n' "${head_ref}" "${config_hash}" "${index_hash}"
}

# @description Run bats with default parallel settings or forward all args to bats verbatim.
#              Snapshots repo state (HEAD, config, index) before and after the run and dies
#              loudly if the suite mutated the real repo — even when bats itself exited 0.
# @arg $@ args Optional bats arguments forwarded verbatim, or empty to run all tests in parallel.
function main() {
  # Unset BASH_ENV so bats' per-test subshells don't re-source the user's
  # interactive ~/.bashrc. That re-source fires for every test subshell —
  # making the full suite many times slower — and clobbers
  # exported vars like SCRIPTS_DIR in child shells, breaking hermeticity.
  unset BASH_ENV
  # bats, flock, and parallel all come from the flake devShell. Named guards beat the
  # tools' own errors: bats --jobs dies inside GNU parallel on a missing flock, with a
  # message that says nothing about how this repo is meant to be run.
  if ! commands::executable_exists 'bats'; then
    log::die "bats not found on PATH — run './.ci/in-devshell ./run-tests' or 'just test'"
  fi
  if ! commands::executable_exists 'flock'; then
    log::die "flock not found on PATH — required for bats --jobs. Run './.ci/in-devshell ./run-tests' or 'just test'"
  fi
  if ! commands::executable_exists 'parallel'; then
    log::die "GNU parallel not found on PATH — required for bats --jobs. Run './.ci/in-devshell ./run-tests' or 'just test'"
  fi
  local before after status=0
  # shellcheck disable=SC2119 # intentional no-arg call; repo_state takes no args
  before="$(repo_state)"
  if (($# == 0)); then
    local targets_file
    files::create_temp targets_file
    # shellcheck disable=SC2119 # intentional no-arg call; default_targets takes no args
    default_targets > "${targets_file}"
    local -a targets
    mapfile -t targets < "${targets_file}"
    bats --jobs "$(nproc)" --recursive --print-output-on-failure "${targets[@]}" || status=$?
  else
    bats "$@" || status=$?
  fi
  # shellcheck disable=SC2119 # intentional no-arg call; repo_state takes no args
  after="$(repo_state)"
  if [[ "${before}" != "${after}" ]]; then
    log::die "test suite mutated the real repo — before: [${before//$'\n'/ }] after: [${after//$'\n'/ }]"
  fi
  exit "${status}"
}

main "$@"
