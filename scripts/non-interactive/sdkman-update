#!/usr/bin/env bash

# @description Update SDKMAN metadata, install/upgrade configured SDKMAN packages and Temurin JDKs, then set the default JDK to the latest installed.
#              A package that fails to install is logged and skipped so the Temurin JDK steps still
#              run; the script then exits 1. Every other step fails fast, so a non-zero exit does
#              not by itself mean package rot. Never blanket-filter non-zero in cron: read the log.
# @noargs
# @exitcode 0 every step succeeded
# @exitcode 1 an SDKMAN package failed to install, or a step aborted via log::die
# @exitcode * a metadata, package-list fetch, or Temurin JDK step failed; its own status is propagated verbatim

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced via SCRIPTS_DIR, not a relative path
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

# Subshell required: sdkman::init relaxes strict mode, which must not leak past the sdk calls.
# The subshell reports its own status deliberately (see overall_exit_code below); the parent's ERR
# trap cannot tell that apart from a crash, so detach it first. Do NOT write `) || exit $?` — making
# the subshell part of an AND-OR list suppresses errexit *inside* the subshell body, which silently
# un-fail-fasts the metadata and Temurin JDK steps. The subshell is the last statement, so errexit
# terminating the parent already yields the identical exit code.
trap - ERR
(
  sdkman::init

  # Records a non-fatal failure so the Temurin JDK steps below still run while the script still
  # reports failure to cron/topgrade. A silent green run would hide a persistent breakage.
  overall_exit_code=0

  log::log 'Updating SDKMAN metadata'
  sdkman::update_metadata
  log::log 'Updated SDKMAN metadata'

  log::log 'Updating SDKMAN packages'
  failed_package_count=0
  # Bare call required: wrapping this in `if`/`||`/`&&` suppresses errexit through the whole call
  # tree, silently reintroducing a failed sdkman.csv download reading as an empty, green run.
  sdkman_packages::install_sdkman_packages failed_package_count
  if ((failed_package_count > 0)); then
    log::warn 'Some SDKMAN packages failed to install; continuing'
    overall_exit_code=1
  else
    log::log 'Updated SDKMAN packages'
  fi

  log::log 'Updating Temurin JDKs'
  sdkman_jdks::install_latest_tem_jdks
  log::log 'Updated Temurin JDKs'

  log::log 'Setting default JDK'
  sdkman_jdks::set_default_jdk_to_latest_patch_of_current_major
  log::log 'Set default JDK'

  exit "${overall_exit_code}"
)
