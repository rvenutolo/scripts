#!/usr/bin/env bash

# @description Run `pre-commit install`, then make every pre-commit-generated git hook in the current repo find bash
# and pre-commit on PATH at run time instead of through the /nix/store paths baked in at install time. A nix-installed
# pre-commit writes absolute store paths into its hooks, which break once an upgrade plus a garbage collection removes
# that store path. Also repairs pre-commit hooks of types not named in this run.
# @arg $@ args Passed through to `pre-commit install` (e.g. `--hook-type commit-msg`).
# @exitcode 1 Not inside a git repo, pre-commit not found, or a hook keeps a store path this script cannot rewrite.

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
# pass-through: any arg count valid

readonly GENERATED_MARKER='# File generated by pre-commit: https://pre-commit.com'
readonly STORE_SHEBANG_REGEX='^#!/nix/store/[^/]+/bin/(bash|sh)$'
readonly STORE_EXEC_REGEX='^exec /nix/store/[^/]+/bin/pre-commit( .*)$'
# The nix hook template execs pre-commit directly and never reads INSTALL_PYTHON, so a store path there is inert.
readonly INERT_LINE_PREFIX='INSTALL_PYTHON='

# Count of hooks left unrepaired. A counter rather than a return status, because calling rewrite_hook as an `if`
# condition would switch errexit off inside it and hide a failed write.
unrewritable_hooks=0

# @description Rewrite one hook file in place (keeping its mode) so it resolves bash and pre-commit on PATH. Leaves
# files pre-commit did not generate, and hooks already free of store paths, untouched. A hook with a store path it
# cannot rewrite is left unmodified and counted in unrewritable_hooks.
# @arg $1 hook path to a git hook file
function rewrite_hook() {
  local -r hook="$1"
  local -a lines
  mapfile -t lines < "${hook}"
  if ((${#lines[@]} < 2)) || [[ "${lines[1]}" != "${GENERATED_MARKER}" ]]; then
    return 0
  fi
  local -a rewritten=()
  local changed='false'
  local line
  for line in "${lines[@]}"; do
    if ((${#rewritten[@]} == 0)) && [[ "${line}" =~ ${STORE_SHEBANG_REGEX} ]]; then
      line="#!/usr/bin/env ${BASH_REMATCH[1]}"
      changed='true'
    elif [[ "${line}" =~ ${STORE_EXEC_REGEX} ]]; then
      line="exec pre-commit${BASH_REMATCH[1]}"
      changed='true'
    fi
    if [[ "${line}" == *'/nix/store/'* && "${line}" != "${INERT_LINE_PREFIX}"* ]]; then
      log::warn "${hook}: cannot rewrite store path in line: ${line}"
      unrewritable_hooks=$((unrewritable_hooks + 1))
      return 0
    fi
    rewritten+=("${line}")
  done
  if [[ "${changed}" == 'false' ]]; then
    return 0
  fi
  # Redirecting into the existing file keeps its executable mode.
  printf '%s\n' "${rewritten[@]}" > "${hook}"
  log::log "Rewrote ${hook} to resolve bash and pre-commit on PATH"
}

function main() {
  git::assert_git_repo "${PWD}"
  commands::assert_executable_exists 'pre-commit'
  pre-commit install "$@"
  local hooks_dir
  hooks_dir="$(git rev-parse --path-format=absolute --git-path hooks)"
  local hook
  for hook in "${hooks_dir}"/*; do
    if files::exists "${hook}" && [[ "${hook}" != *.sample ]]; then
      rewrite_hook "${hook}"
    fi
  done
  # Checked after the loop, so one bad hook does not leave the rest unrepaired.
  if ((unrewritable_hooks > 0)); then
    log::die "${unrewritable_hooks} hook(s) still reference /nix/store; see warnings above"
  fi
}

main "$@"
