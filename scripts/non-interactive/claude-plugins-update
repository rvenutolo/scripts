#!/usr/bin/env bash

# @description Update every installed Claude Code plugin in every Claude profile config dir
#              (`${XDG_CONFIG_HOME}/claude/personal` and `${XDG_CONFIG_HOME}/claude/work`).
#              Each profile's marketplaces are refreshed before its plugins are updated,
#              because an un-refreshed marketplace does not expose new plugin versions.
#              Replaces topgrade's built-in `claude_code_plugins` step, which invokes this
#              repo's `claude` wrapper and therefore derives a single profile from PWD --
#              leaving the other profile's plugins to rot indefinitely.
#              A marketplace refresh or plugin update that fails is logged and skipped so the
#              remaining plugins and profiles are still processed; the script then exits 1.
#              Never blanket-filter a non-zero exit in cron: read the log to see what failed.
# @noargs
# @stdout pass-through output from the underlying claude plugin commands
# @stderr progress lines per profile and per plugin, plus a warning per failure
# @exitcode 0 every marketplace refresh and plugin update succeeded
# @exitcode 1 a refresh, listing, or update failed; claude was not found; or no profile dir exists

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

# Resolve the real binary rather than calling `claude`: that name resolves to this repo's
# wrapper, which derives CLAUDE_CONFIG_DIR from PWD (defeating the per-profile loop below)
# and pins ANTHROPIC_MODEL.
CLAUDE_BIN="$(commands::executable_path claude)" || log::die 'claude executable not found'
readonly CLAUDE_BIN

# Guarded up front so a missing jq is named directly. Without this it surfaces once per profile
# as "Failed to list installed plugins", which misattributes the cause to claude.
commands::assert_executable_exists 'jq'

# @description Update every installed plugin in one Claude profile config dir, refreshing that
#   profile's marketplaces first. Always returns 0; the caller learns about failures through the
#   out-variable, so a bare call keeps errexit armed for everything else this function does.
# @arg $1 config_dir absolute path to a Claude profile config dir
# @arg $2 failure_count_var name of the caller's variable to hold the failure count
# @stderr progress and warning lines
# @exitcode 0 always
function update_profile_plugins() {
  args::check_exactly_2_args "$@"
  local -r config_dir="$1"
  local -n _update_profile_plugins_failure_count="$2"
  local -i failures=0

  # Scopes the profile for every claude invocation below. Re-exported on each call, so the
  # value never leaks from one profile's iteration into the next.
  export CLAUDE_CONFIG_DIR="${config_dir}"

  log::log "Refreshing plugin marketplaces in ${config_dir}"
  # Every claude call below reads stdin from /dev/null. This script runs unattended under
  # topgrade and cron, where stdin is an inherited pipe that never closes; claude reads it and
  # blocks forever rather than failing. /dev/null gives it an immediate EOF.
  if "${CLAUDE_BIN}" plugin marketplace update < '/dev/null'; then
    log::log "Refreshed plugin marketplaces in ${config_dir}"
  else
    log::warn "Failed to refresh plugin marketplaces in ${config_dir}; new plugin versions may be invisible"
    failures+=1
  fi

  local ids_tmp
  files::create_temp ids_tmp
  # shellcheck disable=SC2154 # ids_tmp assigned by files::create_temp via nameref
  if ! "${CLAUDE_BIN}" plugin list --json < '/dev/null' | jq --raw-output '.[].id' > "${ids_tmp}"; then
    log::warn "Failed to list installed plugins in ${config_dir}"
    _update_profile_plugins_failure_count=$((failures + 1))
    return
  fi

  local -a plugin_ids
  mapfile -t plugin_ids < "${ids_tmp}"
  if ((${#plugin_ids[@]} == 0)); then
    log::log "No plugins installed in ${config_dir}"
  fi

  local plugin_id
  for plugin_id in "${plugin_ids[@]}"; do
    log::log "Updating plugin ${plugin_id} in ${config_dir}"
    # --yes is mandatory: under topgrade and cron stdin is not a TTY, and without it the
    # update command fails on the confirmation prompt it cannot ask.
    if "${CLAUDE_BIN}" plugin update --yes "${plugin_id}" < '/dev/null'; then
      log::log "Updated plugin ${plugin_id} in ${config_dir}"
    else
      log::warn "Failed to update plugin ${plugin_id} in ${config_dir}"
      failures+=1
    fi
  done

  # Must be the last statement: assigning the out-variable is what makes this function return 0
  # unconditionally, which is the contract the bare call in main depends on.
  _update_profile_plugins_failure_count="${failures}"
}

function main() {
  # Records non-fatal failures so every remaining plugin and profile is still processed while
  # the script still reports failure to topgrade/cron. A silent green run would hide plugin rot.
  local -i overall_exit_code=0

  local dirs_tmp
  files::create_temp dirs_tmp
  # shellcheck disable=SC2154 # dirs_tmp assigned by files::create_temp via nameref
  claude::profile_dirs > "${dirs_tmp}"
  local -a profile_dirs
  mapfile -t profile_dirs < "${dirs_tmp}"
  if ((${#profile_dirs[@]} == 0)); then
    log::die "No Claude profile config dirs found under ${XDG_CONFIG_HOME}/claude"
  fi

  local profile_dir
  local -i profile_failures
  for profile_dir in "${profile_dirs[@]}"; do
    log::log "Updating Claude plugins in ${profile_dir}"
    profile_failures=0
    # Bare call required: wrapping this in `if`/`||`/`&&` suppresses errexit through the whole
    # call tree, which would let a broken jq or an unwritable temp file read as a green run.
    update_profile_plugins "${profile_dir}" profile_failures
    if ((profile_failures > 0)); then
      log::warn "${profile_failures} Claude plugin step(s) failed in ${profile_dir}; continuing"
      overall_exit_code=1
    else
      log::log "Updated Claude plugins in ${profile_dir}"
    fi
  done

  exit "${overall_exit_code}"
}

main "$@"
