#!/usr/bin/env bash

# @description Launch the real `claude` binary with CLAUDE_CONFIG_DIR resolved:
#              an already-set (non-empty) value is an explicit override and is
#              honored verbatim; otherwise the profile is derived from PWD (at
#              or under ${WORK_PROJECTS_DIR} -> work profile, else personal).
#              Lives in non-interactive/ (not interactive/ like other wrappers)
#              because profile selection must also cover cron, `ssh host
#              claude ...`, and other non-interactive launches. Also passes
#              --model opus[1m] --effort high ahead of the caller's arguments,
#              so a /model or /effort choice another session persisted into
#              settings.json never leaks into a new one; a caller's own
#              --model / --effort still wins, being last.
#              Prepends scripts/shims/claude/ to PATH so the Claude process tree
#              — and nothing else — resolves pkill/killall to the guarding shims.
# @arg $@ args Optional arguments forwarded verbatim to claude.
# @exitcode 1 real claude executable not found

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is not statically followable
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
# pass-through: any arg count valid (forwarded to claude)

CLAUDE_CONFIG_DIR="$(claude::config_dir)"
export CLAUDE_CONFIG_DIR

# Resolve the real binary instead of path::remove, so the exec'd session inherits
# the caller's PATH unmodified except for the shim prepend below. Resolution
# happens BEFORE the prepend so a `claude` inside the shim dir can never win.
claude_bin="$(commands::executable_path claude)" || log::die 'claude executable not found'

# Claude-only PATH shims (pkill/killall guards) — see scripts/shims/claude/.
# Prepended here, not in a profile, so only the Claude process tree (Bash tool,
# subagents, `bash script.sh`) sees them. Warn-and-continue when missing: a
# missing guard must be loud, never a broken claude. CLAUDE_SHIMS_DIR_OVERRIDE is
# a test seam on the derived path; production leaves it unset.
claude_shims="${CLAUDE_SHIMS_DIR_OVERRIDE:-${SCRIPTS_DIR}/shims/claude}"
if dirs::exists "${claude_shims}"; then
  claude_shims="$(cd -P -- "${claude_shims}" && pwd -P)"
  path::prepend "${claude_shims}"
  export PATH
else
  log::warn "claude shims dir missing: ${claude_shims} (pkill/killall guard inactive)"
fi

# Pin the default model and effort. /model and /effort persist their choice into
# settings.json, so a one-off switch in one session silently becomes every later
# session's default. The flags override settings.json at launch, so a session
# always starts here regardless of what another session wrote.
#
# Flags rather than env vars, deliberately. CLAUDE_CODE_EFFORT_LEVEL also pins
# effort at launch, but as a hard session lock: an in-session /effort answers
# "Not applied: ..." and only records the choice for later. A flag's pin is
# released by /effort or /model in an interactive terminal, and setting a default
# should not cost mid-session tuning. ANTHROPIC_MODEL does not lock /model, but
# the flag beats it anyway, so using both would be a second way to say the same
# thing with a different override story.
#
# Placed before "$@" because argument parsing is last-wins: a caller's own
# --model / --effort overrides these. An already-set CLAUDE_CODE_EFFORT_LEVEL
# still wins over both, being the stronger mechanism.
exec "${claude_bin}" --model 'opus[1m]' --effort high "$@"
