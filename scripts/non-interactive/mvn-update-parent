#!/usr/bin/env bash

# @description Run `mvn versions:update-parent` against the current Maven project, skipping
#   pre-release parent versions (alpha, beta, milestone, RC) unless the project configures its own filter.
# @noargs

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

mvn versions:update-parent "-Dmaven.version.ignore=$(mvn::prerelease_ignore_regex)"
