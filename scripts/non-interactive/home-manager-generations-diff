#!/usr/bin/env bash

# @description Show the nix store closure diff between the two most recent home-manager generations.
# @noargs
# @stdout `nix store diff-closures` output between the previous and current generation.

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is sourced from SCRIPTS_DIR at runtime
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

# The full listing goes to a file first: `head` exits after two lines, which would kill a still-writing
# `home-manager generations` with SIGPIPE and fail the pipeline under pipefail.
files::create_temp generations_file
# shellcheck disable=SC2154 # generations_file assigned by files::create_temp nameref
home-manager generations > "${generations_file}"
head --lines=2 -- "${generations_file}" \
  | tac \
  | cut --delimiter=' ' --fields=7 \
  | xargs --no-run-if-empty nix store diff-closures
