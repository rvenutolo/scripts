#!/usr/bin/env bash

# @description Interactively configure UFW with deny-incoming/allow-outgoing defaults plus tailnet, ssh, and server-only beszel rules, then enable it.
# @noargs

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # source path not known statically
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
args::handle_help_flag "$@"
args::check_no_args "$@"

if ! commands::executable_exists 'ufw'; then
  log::log 'ufw executable not found'
  exit 0
fi

incoming_policy="$(ufw::default_policy 'incoming')"
readonly incoming_policy
if [[ "${incoming_policy}" != 'deny' ]]; then
  if prompt::yn 'Set UFW to deny incoming?'; then
    sudo ufw default deny 'incoming'
  fi
fi

if ! ufw::rule_exists allow in on 'tailscale0'; then
  if prompt::yn 'Set UFW to allow incoming traffic from tailnet?'; then
    ufw::add_rule allow in on 'tailscale0'
  fi
fi

# Any existing allow or limit rule that lets ssh in counts, so a deliberate `limit` is never replaced by a plain allow.
# `ssh` and `22/tcp` are the same ufw rule; `22` (any protocol) and the OpenSSH app profile are distinct ones. The
# profile is checked only when ufw knows it, because a dry-run naming an unknown profile is a ufw error.
ssh_targets=('ssh' '22')
if ufw::app_profile_exists 'OpenSSH'; then
  ssh_targets+=('OpenSSH')
fi
readonly ssh_targets
ssh_allowed='false'
for ssh_action in 'allow' 'limit'; do
  for ssh_target in "${ssh_targets[@]}"; do
    if ufw::rule_exists "${ssh_action}" "${ssh_target}"; then
      ssh_allowed='true'
      break 2
    fi
  done
done
readonly ssh_allowed
if [[ "${ssh_allowed}" == 'false' ]]; then
  if prompt::yn 'Set UFW to allow incoming traffic on port 22 (ssh)?'; then
    ufw::add_rule allow ssh
  fi
fi

if hosts::is_server \
  && ! ufw::rule_exists allow from '169.254.0.0/16' to any port '45876' proto 'tcp'; then
  if prompt::ny 'Set UFW to allow incoming traffic on port 45876 (beszel) from 169.254.0.0/16 (docker IP range)?'; then
    ufw::add_rule allow from '169.254.0.0/16' to any port '45876' proto 'tcp'
  fi
fi

outgoing_policy="$(ufw::default_policy 'outgoing')"
readonly outgoing_policy
if [[ "${outgoing_policy}" != 'allow' ]]; then
  if prompt::yn 'Set UFW to allow outgoing?'; then
    sudo ufw default allow 'outgoing'
  fi
fi

# Both checks, because the start-at-boot flag can be set while the firewall is down.
ufw_status="$(ufw::status)"
readonly ufw_status
if ! ufw::is_enabled || [[ "${ufw_status}" != 'active' ]]; then
  if prompt::yn 'Enable UFW?'; then
    sudo ufw --force enable
  fi
fi
