#!/usr/bin/env bash

# @description Run `claude` with CLAUDE_CONFIG_DIR forced to the work profile,
#              overriding derivation and any inherited value (the wrapper in
#              non-interactive/ honors a set value verbatim).
# @arg $@ args Optional arguments forwarded verbatim to claude.

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is not statically followable
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
# pass-through: any arg count valid (forwarded to claude)

CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME}/claude/work" exec claude "$@"
