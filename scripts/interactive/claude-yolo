#!/usr/bin/env bash

# @description Launch `claude` (via the config-dir-resolving wrapper in
#              non-interactive/) with --dangerously-skip-permissions.
# @arg $@ args Optional arguments forwarded verbatim to claude.

set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck disable=SC1091 # .functions.bash is not statically followable
source "${SCRIPTS_DIR}/.functions.bash"
log::enable_err_trap
# pass-through: any arg count valid (forwarded to claude)

# `claude` resolves to scripts/non-interactive/claude, which handles
# CLAUDE_CONFIG_DIR honor-or-derive selection
exec claude --dangerously-skip-permissions "$@"
